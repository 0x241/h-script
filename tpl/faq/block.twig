
{% if list %}
	{% if _cfg.FAQ_InBlock == 1 %}
		{% set l = reset(list) %}
		<div>
			<h3>{{ l.fQuestion }}</h3>
			<div>
				<small>{{ l.fCat }}</small><br>
				{{ l.fAnswer }}
			</div>
		</div>
	{% else %}
		{% for id, l in list %}
			<div>
				<h3>{{ l.fQuestion }}</h3>
				<div>
					<small>{{ l.fCat }}</small><br>
					{{ l.fAnswer|truncate(40) }}
				</div>
			</div>
		{% endfor %}
	{% endif %}
{% endif %}
