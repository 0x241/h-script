{% include "external/header.twig" with {"title": 'FAQ', "public_active": 'faq'} %}

<main id="content" class="flex-1 pt-40 pb-20 px-6 max-w-7xl mx-auto w-full">
	<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-6">
		<div>
			<div class="mb-3 flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-textDim dark:text-gray-500">
				<i class="fa-solid fa-circle-question text-blue-500" aria-hidden="true"></i>
				<span>{{ _t({"key": 'faq.total', "default": 'Всего ответов'}) }}</span>
				<span class="inline-flex min-w-7 items-center justify-center rounded-full bg-blue-50 px-2 py-1 font-mono text-xs text-blue-600 dark:bg-blue-500/10 dark:text-blue-300">{{ pl_params.RowsCount|default(list|count) }}</span>
			</div>
			<h1 class="text-4xl md:text-5xl font-bold text-brand dark:text-white tracking-tight mb-2">{{ _t({"key": 'faq.heading', "default": 'Часто задаваемые вопросы'}) }}</h1>
			<p class="text-xl text-textDim dark:text-gray-400 font-medium">{{ _t({"key": 'faq.text', "default": 'Ответы на самые популярные вопросы по работе платформы'}) }}</p>
		</div>
	</div>

	{% if list %}
		<div class="space-y-10">
			{% for category in categories %}
				<section aria-labelledby="faq-category-{{ loop.index }}">
					<h2 id="faq-category-{{ loop.index }}" class="mb-5 text-2xl font-bold tracking-tight text-brand dark:text-white">{% if category.name %}{{ category.name }}{% else %}{{ _t({"key": 'faq.category.general', "default": 'Общие вопросы'}) }}{% endif %}</h2>
					<div class="space-y-4">
						{% for l in category.items %}
							<details class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 open:border-blue-500 open:bg-[#EBF5FF] dark:border-gray-800 dark:bg-[#151515] dark:open:border-blue-500 dark:open:bg-blue-500/10">
								<summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 text-xl font-bold text-brand transition-colors hover:text-blue-500 dark:text-white dark:hover:text-blue-400 [&::-webkit-details-marker]:hidden">
									<span>{{ l.fQuestion }}</span>
									<i class="fa-solid fa-chevron-down text-gray-400 transition-transform group-open:rotate-180 group-open:text-blue-500" aria-hidden="true"></i>
								</summary>
								<div class="p-6 pt-0 text-lg leading-relaxed text-textDim dark:text-gray-400">{{ l.fAnswer|raw }}</div>
							</details>
						{% endfor %}
					</div>
				</section>
			{% endfor %}
		</div>
		{% include "external/pl.twig" %}
	{% else %}
		<div class="bg-white dark:bg-[#151515] border border-gray-200 dark:border-gray-800 rounded-2xl p-10 text-center">
			<div class="w-14 h-14 mx-auto mb-5 rounded-full bg-gray-100 dark:bg-[#1A1A1A] flex items-center justify-center text-gray-400">
				<i class="fa-solid fa-circle-question text-2xl"></i>
			</div>
			<h3 class="text-2xl font-bold text-brand dark:text-white">{{ _t({"key": 'faq.empty', "default": 'FAQ пока пуст'}) }}</h3>
		</div>
	{% endif %}
</main>

{% include "external/footer.twig" %}
