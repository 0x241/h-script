{% if list %}
	<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
		{% for id, l in list %}
			<article class="group flex flex-col rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-800 dark:bg-[#151515]">
				<div class="mb-5 flex items-start justify-between gap-4">
					<span class="font-mono text-sm text-gray-500">{{ l.nTS }}</span>
					{% if l.nAttn %}
						<span class="rounded-full bg-red-100 px-3 py-1 text-xs font-extrabold uppercase tracking-wide text-red-600 dark:bg-red-900/30 dark:text-red-400">{{ _t({"key": 'news.important', "default": 'Важно!'}) }}</span>
					{% endif %}
				</div>
				<h3 class="mb-4 text-2xl font-bold text-brand transition-colors group-hover:text-blue-500 dark:text-white"><a href="{{ _link('news/show', [l.nID, l.nTopic], 0) }}">{{ l.nTopic }}</a></h3>
				<p class="mb-7 flex-1 leading-relaxed text-textDim dark:text-gray-400">{{ l.nAnnounce|striptags|truncate(180) }}</p>
				<a class="inline-flex items-center gap-2 font-bold text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400" href="{{ _link('news/show', [l.nID, l.nTopic], 0) }}">
					<span>{{ _t({"key": 'news.read_more', "default": 'Читать полностью'}) }}</span><i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
				</a>
			</article>
		{% endfor %}
	</div>
{% endif %}
