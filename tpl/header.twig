{% set current_theme = 'light' %}
{% if isset(_COOKIE.theme) and _COOKIE.theme == 'dark' %}
	{% set current_theme = 'dark' %}
{% elseif user.uTheme == 'dark' %}
	{% set current_theme = 'dark' %}
{% endif %}
{% set theme_next = 'dark' %}
{% if current_theme == 'dark' %}
	{% set theme_next = 'light' %}
{% endif %}
{% set theme_lang = 'ru' %}
{% if current_lang %}
	{% set theme_lang = current_lang %}
{% endif %}
{% set theme_toggle_url = _link('system', false, 0) ~ '?lang=' ~ theme_lang ~ '&theme=' ~ theme_next ~ '&url=' ~ (fullURL()|url_encode) %}
{% set lang_str = "" %}
{% if is_array(_cfg.UI__Langs) %}
	{% set lang_str = "\n"|implode(_cfg.UI__Langs) %}
{% else %}
	{% set lang_str = _cfg.UI__Langs %}
{% endif %}
{% set hs_clean_langs = "\n"|explode(lang_str) %}
<!doctype html>
<html lang="{% if current_lang %}{{ current_lang }}{% else %}ru{% endif %}" class="{{ current_theme }}" data-theme="{{ current_theme }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% if title %}{{ title }} | {% endif %}{{ _cfg.Sys_SiteName }}</title>
		<base href="{{ root_url }}">
		<link rel="icon" type="image/svg+xml" href="favicon.svg">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
		<link rel="stylesheet" type="text/css" href="static/css/app.css?v=tailwind-20260813-ui-15">
		<script src="static/js/htmx.min.js"></script>
		<script src="static/js/app.js?v=20260812-2" defer></script>
	</head>
	<body class="min-h-screen bg-bgLight text-brand antialiased dark:bg-[#0A0A0A] dark:text-gray-100 lg:flex {% if body_class %}{{ body_class }}{% endif %}">
	<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:text-sm focus:font-bold focus:text-white dark:focus:bg-white dark:focus:text-brand" href="{{ fullURL() }}#content" hx-boost="false">{{ _t({"key": 'site.skip_content', "default": 'Перейти к содержимому'}) }}</a>
	{% if not short %}
		<input id="cms-sidebar-toggle" class="peer sr-only" type="checkbox">
		<label for="cms-sidebar-toggle" class="fixed inset-0 z-40 hidden bg-black/45 peer-checked:block lg:hidden" aria-label="{{ _t({"key": 'nav.close', "default": 'Закрыть меню'}) }}"></label>
		{% include "line.top.twig" %}
		<main id="content" class="flex min-h-screen min-w-0 flex-1 flex-col">
			{% if impersonator.uID %}
				<div class="flex flex-col items-start justify-between gap-3 border-b border-amber-200 bg-amber-50 px-6 py-3 text-sm text-amber-950 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-100 sm:flex-row sm:items-center">
					<div class="flex items-center gap-3">
						<i class="fa-solid fa-user-secret text-lg" aria-hidden="true"></i>
						<span><strong>Вход под пользователем {{ user.uLogin }}.</strong> Администратор: {{ impersonator.uLogin }}.</span>
					</div>
					{% set return_admin_form_name = getFormName('return_admin') %}
					<form method="post" action="{{ _link('account/login', false, 0) }}" name="{{ return_admin_form_name }}">
						{{ _getFormSecurity({"form": return_admin_form_name}) }}
						<button name="{{ return_admin_form_name }}_btn" value="1" type="submit" class="inline-flex items-center gap-2 rounded-xl bg-amber-900 px-4 py-2 font-extrabold text-white transition hover:bg-amber-800 dark:bg-amber-300 dark:text-amber-950 dark:hover:bg-amber-200">
							<i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
							Вернуться в админку
						</button>
					</form>
				</div>
			{% endif %}
			<header class="sticky top-0 z-30 flex h-20 items-center justify-between border-b border-gray-100 bg-white/70 px-6 backdrop-blur-xl dark:border-gray-800 dark:bg-[#151515]/70">
				<div class="flex min-w-0 items-center gap-4">
					<label for="cms-sidebar-toggle" class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-xl text-brand transition-colors hover:bg-gray-100 dark:text-white dark:hover:bg-[#202020] lg:hidden" aria-label="{{ _t({"key": 'nav.main.label', "default": 'Меню'}) }}">
						<i class="fa-solid fa-bars" aria-hidden="true"></i>
					</label>
					<h1 class="hidden truncate text-xl font-bold text-brand dark:text-white sm:block">{% if title %}{{ title }}{% else %}{{ _t({"key": 'nav.cabinet', "default": 'Кабинет'}) }}{% endif %}</h1>
				</div>
				<div class="flex items-center gap-2 sm:gap-4">
					<details class="relative" hx-boost="false">
						<summary class="flex h-10 cursor-pointer list-none items-center justify-center gap-1.5 rounded-full px-3 text-sm font-bold tracking-wide text-gray-500 transition-colors hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-[#202020]">
							<i class="fa-solid fa-globe" aria-hidden="true"></i>
							{% if current_lang %}{{ current_lang|upper }}{% else %}RU{% endif %}
						</summary>
						<div class="absolute right-0 top-full z-50 mt-2 w-32 overflow-hidden rounded-xl border border-gray-100 bg-white shadow-xl dark:border-gray-800 dark:bg-[#1A1A1A]">
							{% for lng in hs_clean_langs %}
								{% set lng_clean = lng|trim %}
								{% if lng_clean %}
									<a href="{% if tpl_module == 'system' %}{{ _link('system', false, 0) }}?lang={{ lng_clean }}{% else %}{{ _link('system', false, 0) }}?lang={{ lng_clean }}&url={{ _link(tpl_module, false, 0) }}{% endif %}" class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-brand transition-colors hover:bg-gray-50 dark:text-white dark:hover:bg-black{% if current_lang == lng_clean %} bg-gray-50/70 dark:bg-black/30{% endif %}">
										<span class="{% if current_lang == lng_clean %}text-blue-500{% else %}text-gray-400{% endif %}">{{ lng_clean|upper }}</span>
										{{ lng_clean|upper }}
									</a>
								{% endif %}
							{% endfor %}
						</div>
					</details>
					<a href="{{ theme_toggle_url }}" hx-boost="false" class="flex h-10 w-10 items-center justify-center rounded-full border border-transparent text-brand transition-all duration-200 hover:border-black/10 hover:bg-black/5 dark:text-white dark:hover:border-white/10 dark:hover:bg-white/5" aria-label="{{ _t({"key": 'theme.toggle', "default": 'Сменить тему'}) }}" title="{{ _t({"key": 'theme.toggle', "default": 'Сменить тему'}) }}">
						<i class="fa-solid fa-moon block text-lg dark:!hidden" aria-hidden="true"></i>
						<i class="fa-solid fa-sun !hidden text-lg text-yellow-400 dark:!block" aria-hidden="true"></i>
					</a>
					<a href="{{ _link('message', false, 0) }}" class="relative flex h-10 w-10 items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-[#202020]" aria-label="{{ _t({"key": 'nav.messages', "default": 'Сообщения'}) }}">
						<i class="fa-solid fa-bell" aria-hidden="true"></i>
						{% if count_msg > 0 %}
							<span class="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full border-2 border-white bg-red-500 px-1 text-[10px] font-bold leading-none text-white dark:border-[#151515]">{{ count_msg }}</span>
						{% endif %}
					</a>
				</div>
			</header>
			<div class="mx-auto w-full max-w-7xl flex-1 p-6 lg:p-10">
				{% include "info.twig" with {"_info": tpl_info} %}
	{% endif %}
