{% set progress_value = l.CurrentProgress|default(valueIf(l.dState == 1, 0, 100)) %}
{% if progress_value >= 95 %}
	{% set progress_width = 'w-full' %}
{% elseif progress_value >= 75 %}
	{% set progress_width = 'w-3/4' %}
{% elseif progress_value >= 50 %}
	{% set progress_width = 'w-1/2' %}
{% elseif progress_value >= 25 %}
	{% set progress_width = 'w-1/4' %}
{% elseif progress_value > 0 %}
	{% set progress_width = 'w-1/6' %}
{% else %}
	{% set progress_width = 'w-0' %}
{% endif %}

<td class="px-4 py-4 font-mono text-gray-400">#{{ l.dID }}</td>
<td class="px-4 py-4 text-gray-500">{{ l.dCTS }}</td>
<td class="px-4 py-4 font-bold text-brand dark:text-white">{{ l.cName }}</td>
<td class="px-4 py-4 text-right font-mono font-bold text-brand dark:text-white">{{ _z(l.dZD, l.dcID, -1) }}</td>
<td class="px-4 py-4">
	<a href="{{ _link('depo/depo', false, 0) }}?id={{ l.dID }}" class="font-bold text-brand hover:text-blue-500 dark:text-white dark:hover:text-blue-400">{{ l.pName }}</a>
</td>
<td class="px-4 py-4 text-gray-500">{{ l.dLTS }}</td>
<td class="px-4 py-4">
	<div class="flex items-center gap-2">
		<div class="h-1.5 w-16 rounded-full bg-gray-200 dark:bg-gray-800">
			<div class="h-1.5 rounded-full bg-blue-500 {{ progress_width }}"></div>
		</div>
		<span class="text-xs font-bold text-gray-500">{{ l.dNPer }} / {{ valueIf(l.pNPer, l.pNPer, '-') }}</span>
	</div>
</td>
<td class="px-4 py-4 text-right font-mono font-bold text-emerald-500">{{ _z(l.dZP, l.dcID, -1) }}</td>
<td class="px-4 py-4 text-center font-mono font-bold text-blue-500">
	{% if l.dState == 1 and l.Timer %}
		{{ l.Timer.D }}д {{ l.Timer.H }}:{{ l.Timer.M }}:{{ l.Timer.S }}
	{% elseif l.dState == 1 %}
		{{ l.dNTS }}
	{% else %}
		&mdash;
	{% endif %}
</td>
<td class="px-4 py-4 text-center">
	<a href="{{ _link('depo/depo', false, 0) }}?id={{ l.dID }}" class="inline-flex items-center rounded-full px-3 py-1 text-xs font-bold {% if l.dState == 1 %}bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400{% else %}bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300{% endif %}">
		{{ ststrs[l.dState]|default(l.dState) }}
	</a>
</td>
