
{% include "header.twig" with {"depo_css": "topin", "title": 'Топ инвесторов'} %}

<div class="hs-page-title hs-page-title--flex">
	<div>
		<span class="hs-page-title__eyebrow"><i class="fa-solid fa-ranking-star" style="margin-right: 6px;"></i> Зал славы</span>
		<h1>Крупнейшие инвесторы</h1>
	</div>
</div>


<div class="hs-stat-card">
	<div class="card-head">
		<h3 style="margin:0; font-size: 1.3rem; color: var(--color-primary-ink);"><i class="fa-solid fa-trophy" style="color: var(--color-warning); margin-right: 8px;"></i> Топ по портфелям</h3>
		<p style="margin: 4px 0 0; font-size: 0.88-rem; color: var(--color-text-muted);">Лидеры по суммарному объему действующих инвестиционных портфелей</p>
	</div>
	{% if list %}
		<table class="hs-stat-table">
			<tr>
				<th>Пользователь</th>
				<th style="text-align: right;">Сумма депозитов</th>
			</tr>
			{% for i, r in list %}
				{% if r.RSUM > 0 %}
					<tr>
						<td>
							<div class="hs-user-cell">
								{% include "_usericon.twig" with {"user": r} %}
								<span>{{ r.uLogin }}</span>
							</div>
						</td>
						<td align="right"><span class="hs-stat-val">{{ _z(r.RSUM, 1) }}</span></td>
					</tr>
				{% endif %}
			{% endfor %}
		</table>
	{% else %}
		<p style="color: var(--color-text-muted); text-align: center; margin: 24px 0;">Данные статистики временно отсутствуют.</p>
	{% endif %}
</div>

{% include "footer.twig" %}
