
{% include "header.twig" with {"depo_css": "top", "title": 'Лучшие партнеры'} %}

<div class="hs-page-title hs-page-title--flex">
	<div>
		<span class="hs-page-title__eyebrow"><i class="fa-solid fa-users-rays" style="margin-right: 6px;"></i> Партнерская программа</span>
		<h1>Лидеры приглашений</h1>
	</div>
</div>


<div class="hs-top-grid">
	<div class="hs-stat-card">
		<div class="card-head">
			<h3 style="margin:0; font-size: 1.3rem; color: var(--color-primary-ink);"><i class="fa-solid fa-trophy" style="color: var(--color-warning); margin-right: 8px;"></i> Топ по суммам</h3>
			<p style="margin: 4px 0 0; font-size: 0.88-rem; color: var(--color-text-muted);">Рейтинг партнеров по объему инвестиций структуры</p>
		</div>
		{% if list1 %}
			<table class="hs-stat-table">
				<tr>
					<th>Пользователь</th>
					<th style="text-align: right;">Сумма оборота</th>
				</tr>
				{% for i, r in list1 %}
					{% if r.RSUM > 0 %}
						<tr>
							<td>
								<div class="hs-user-cell">
									{% include "_usericon.twig" with {"user": r} %}
									<span>{{ r.uLogin }}</span>
								</div>
							</td>
							<td align="right"><span class="hs-stat-val">{{ _z(r.RSUM, 1) }}</span></td>
						</tr>
					{% endif %}
				{% endfor %}
			</table>
		{% else %}
			<p style="color: var(--color-text-muted); text-align: center; margin: 24px 0;">Данные статистики временно отсутствуют.</p>
		{% endif %}
	</div>

	<div class="hs-stat-card">
		<div class="card-head">
			<h3 style="margin:0; font-size: 1.3rem; color: var(--color-primary-ink);"><i class="fa-solid fa-medal" style="color: var(--color-accent); margin-right: 8px;"></i> Топ по количеству</h3>
			<p style="margin: 4px 0 0; font-size: 0.88-rem; color: var(--color-text-muted);">Рейтинг по числу приглашенных активных участников</p>
		</div>
		{% if list2 %}
			<table class="hs-stat-table">
				<tr>
					<th>Пользователь</th>
					<th style="text-align: right;">Партнеров</th>
				</tr>
				{% for i, r in list2 %}
					{% if r.RCNT > 0 %}
						<tr>
							<td>
								<div class="hs-user-cell">
									{% include "_usericon.twig" with {"user": r} %}
									<span>{{ r.uLogin }}</span>
								</div>
							</td>
							<td align="right"><span class="hs-stat-cnt">{{ r.RCNT }}</span></td>
						</tr>
					{% endif %}
				{% endfor %}
			</table>
		{% else %}
			<p style="color: var(--color-text-muted); text-align: center; margin: 24px 0;">Данные статистики временно отсутствуют.</p>
		{% endif %}
	</div>
</div>

{% include "footer.twig" %}
