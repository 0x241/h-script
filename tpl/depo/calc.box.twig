<form method="get" action="{{ _link('depo/calc', false, 0) }}" name="calc" class="space-y-8">
	<div class="rounded-[1.5rem] border border-gray-100 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-[#151515] sm:p-8">
		<h3 class="mb-6 text-xl font-bold text-brand dark:text-white">{{ _t({"key": 'calc.plan.title', "default": '1. Выберите тарифный план'}) }}</h3>
		<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
			{% for plan in calc_plan_rows %}
				<label class="relative block cursor-pointer">
					<input type="radio" name="plan" value="{{ loop.index0 }}" class="peer sr-only" {% if calc_selected_plan == loop.index0 %}checked{% endif %}>
					<span class="block rounded-2xl border-2 border-gray-100 p-6 transition-all hover:border-gray-300 peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:border-gray-800 dark:hover:border-gray-600 dark:peer-checked:border-emerald-500 dark:peer-checked:bg-emerald-500/10">
						<span class="mb-4 flex items-start justify-between gap-4">
							<span class="text-lg font-bold text-brand dark:text-white">{{ plan.name }}</span>
							<span class="shrink-0 rounded bg-emerald-100 px-2 py-1 text-xs font-bold text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">{{ plan.perc|number_format(2, '.', ' ') }}%</span>
						</span>
						<span class="space-y-1 text-sm text-gray-500">
							<span class="block">{{ _t({"key": 'calc.plan.days', "default": 'Срок'}) }}: <b>{{ plan.days }}</b></span>
							<span class="block">{{ _t({"key": 'calc.plan.min', "default": 'Мин. депозит'}) }}: <b>$ {{ plan.min|number_format(2, '.', ' ') }}</b></span>
							<span class="block">{{ _t({"key": 'calc.plan.max', "default": 'Макс. депозит'}) }}: <b>$ {{ plan.max|number_format(2, '.', ' ') }}</b></span>
						</span>
					</span>
				</label>
			{% else %}
				<div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm font-semibold text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-100">{{ _t({"key": 'calc.no_plans', "default": 'Доступных тарифных планов пока нет.'}) }}</div>
			{% endfor %}
		</div>
	</div>

	<div class="rounded-[1.5rem] border border-gray-100 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-[#151515] sm:p-8">
		<h3 class="mb-6 text-xl font-bold text-brand dark:text-white">{{ _t({"key": 'calc.amount.title', "default": '2. Введите сумму инвестиции'}) }}</h3>
		<div class="grid grid-cols-1 items-end gap-4 {% if calc_compnd %}md:grid-cols-[minmax(0,1fr)_minmax(220px,260px)_auto]{% else %}md:grid-cols-[minmax(0,1fr)_auto]{% endif %}">
			<div>
				<label class="sr-only" for="calc_sum">{{ _t({"key": 'calc.amount.label', "default": 'Сумма вклада'}) }}</label>
				<div class="relative">
					<span class="absolute left-6 top-1/2 -translate-y-1/2 text-xl font-bold text-gray-400">$</span>
					<input id="calc_sum" name="sum" value="{{ calc_sum_value|number_format(2, '.', '') }}" type="number" min="0.01" step="0.01" inputmode="decimal" class="h-16 w-full rounded-2xl border border-black/10 bg-white px-5 pl-12 font-mono text-2xl font-bold text-brand outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-white/10 dark:bg-[#151515] dark:text-white dark:placeholder:text-gray-500">
				</div>
			</div>
			{% if calc_compnd %}
				<div>
					<label class="mb-2 block text-sm font-bold text-gray-700 dark:text-gray-300" for="calc_cmpd">{{ _t({"key": 'calc.compound.label', "default": 'Реинвестирование'}) }}</label>
					<div class="relative">
						<select id="calc_cmpd" name="cmpd" class="h-16 w-full appearance-none rounded-2xl border border-black/10 bg-white px-5 pr-12 font-mono font-bold text-brand outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-white/10 dark:bg-[#151515] dark:text-white">
							{% for cmpd_value in calc_compnd %}
								<option value="{{ cmpd_value }}" {% if calc_cmpd_value == cmpd_value %}selected{% endif %}>{{ cmpd_value }}%</option>
							{% endfor %}
						</select>
						<i class="fa-solid fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-gray-400" aria-hidden="true"></i>
					</div>
				</div>
			{% endif %}
			<div>
				<button type="submit" class="h-16 w-full whitespace-nowrap rounded-2xl bg-brand px-7 font-bold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-black disabled:cursor-not-allowed disabled:opacity-50 dark:bg-white dark:text-brand dark:hover:bg-gray-100 md:w-auto" {% if not calc_plan_rows %}disabled{% endif %}>{{ _t({"key": 'calc.submit', "default": 'Рассчитать прибыль'}) }}</button>
			</div>
		</div>
	</div>
</form>
