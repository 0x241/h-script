{% if calc_result and calc_result.plan %}
	{% set plan = calc_result.plan %}
	<div class="sticky top-28 rounded-[1.5rem] bg-brand p-8 text-white shadow-xl dark:bg-[#1A1A1A]">
		<div class="mb-6 flex items-center gap-3 text-emerald-400">
			<div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500/20 text-xl">
				<i class="fa-solid fa-chart-line" aria-hidden="true"></i>
			</div>
			<h3 class="text-lg font-bold">{{ _t({"key": 'calc.result.title', "default": 'Детали расчета'}) }}</h3>
		</div>

		<div class="mb-5 rounded-2xl bg-white/5 p-4">
			<div class="text-xs font-bold uppercase tracking-wider text-gray-400">{{ _t({"key": 'calc.result.plan', "default": 'Инвестиционный план'}) }}</div>
			<div class="mt-1 text-xl font-bold">{{ plan.name }}</div>
		</div>

		<div class="space-y-4 text-sm">
			<div class="flex items-center justify-between border-b border-white/10 pb-3">
				<span class="font-bold text-gray-400">{{ _t({"key": 'calc.result.bonus', "default": 'Бонус'}) }}</span>
				<span class="font-mono font-bold">{{ plan.bonus|number_format(2, '.', ' ') }}%</span>
			</div>
			<div class="flex items-center justify-between border-b border-white/10 pb-3">
				<span class="font-bold text-gray-400">{{ _t({"key": 'calc.result.profit', "default": 'Начисление'}) }}</span>
				<span class="font-mono font-bold text-emerald-400">{{ plan.perc|number_format(2, '.', ' ') }}%</span>
			</div>
			<div class="flex items-center justify-between border-b border-white/10 pb-3">
				<span class="font-bold text-gray-400">{{ _t({"key": 'calc.result.periods', "default": 'Кол-во начислений'}) }}</span>
				<span class="font-mono font-bold">{{ plan.periods }}</span>
			</div>
			<div class="flex items-center justify-between border-b border-white/10 pb-3">
				<span class="font-bold text-gray-400">{{ _t({"key": 'calc.result.days', "default": 'Длительность, дней'}) }}</span>
				<span class="font-mono font-bold">{{ plan.days }}</span>
			</div>
			<div class="flex items-center justify-between border-b border-white/10 pb-3">
				<span class="font-bold text-gray-400">{{ _t({"key": 'calc.result.compound', "default": 'Реинвестирование'}) }}</span>
				<span class="font-mono font-bold">{{ calc_cmpd_value|number_format(2, '.', ' ') }}%</span>
			</div>
			<div class="flex items-center justify-between border-b border-white/10 pb-3">
				<span class="font-bold text-gray-400">{{ _t({"key": 'calc.result.return', "default": 'Возврат депозита'}) }}</span>
				<span class="font-mono font-bold text-emerald-400">{{ plan.return|number_format(2, '.', ' ') }}%</span>
			</div>
			<div class="pt-2">
				<div class="mb-1 font-bold text-gray-400">{{ _t({"key": 'calc.result.profit_sum', "default": 'Сумма начисленных процентов'}) }}</div>
				<div class="font-mono text-2xl font-bold text-emerald-400">$ {{ calc_result.profit_sum|number_format(2, '.', ' ') }}</div>
			</div>
			<div class="pt-2">
				<div class="mb-1 font-bold text-gray-400">{{ _t({"key": 'calc.result.total', "default": 'Всего к возврату'}) }}</div>
				<div class="font-mono text-3xl font-bold">$ {{ calc_result.total_return_sum|number_format(2, '.', ' ') }}</div>
			</div>
		</div>

		<div class="mt-8">
			<a href="{{ _link('depo/depo', false, 0) }}?add=DEPO" class="block w-full rounded-xl bg-white py-4 text-center font-bold text-brand transition-opacity hover:opacity-90 dark:bg-emerald-500 dark:text-white">{{ _t({"key": 'calc.result.invest', "default": 'Инвестировать сейчас'}) }}</a>
		</div>
	</div>
{% else %}
	<div class="rounded-[1.5rem] border border-gray-100 bg-white p-8 text-gray-500 shadow-sm dark:border-gray-800 dark:bg-[#151515]">
		<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-xl text-gray-400 dark:bg-[#1A1A1A]">
			<i class="fa-solid fa-chart-line" aria-hidden="true"></i>
		</div>
		<div class="text-lg font-bold text-brand dark:text-white">{{ _t({"key": 'calc.empty.title', "default": 'Расчет недоступен'}) }}</div>
		<p class="mt-2 text-sm">{{ _t({"key": 'calc.empty.text', "default": 'Добавьте активные тарифные планы, чтобы калькулятор показал прогноз.'}) }}</p>
	</div>
{% endif %}
