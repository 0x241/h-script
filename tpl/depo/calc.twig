{% include "header.twig" with {"title": _t({"key": 'cabinet.calc', "default": 'Калькулятор'})} %}

<div class="mx-auto w-full max-w-6xl">
	<div class="mb-8">
		<h2 class="mb-2 text-3xl font-bold text-brand dark:text-white">{{ _t({"key": 'calc.title', "default": 'Рассчитайте свою прибыль'}) }}</h2>
		<p class="max-w-3xl text-textDim dark:text-gray-400">{{ _t({"key": 'calc.subtitle', "default": 'Выберите инвестиционный план и введите сумму депозита для расчета доходности.'}) }}</p>
	</div>

	<div class="flex flex-col gap-8 lg:flex-row">
		<div class="w-full space-y-8 lg:w-2/3">
			{% include "depo/calc.box.twig" %}
		</div>
		<div class="w-full lg:w-1/3">
			{% include "depo/calc.result.twig" %}
		</div>
	</div>
</div>

{% include "footer.twig" %}
