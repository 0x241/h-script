{% set current_theme = 'light' %}
{% if isset(_COOKIE.theme) and _COOKIE.theme == 'dark' %}
	{% set current_theme = 'dark' %}
{% elseif user.uTheme == 'dark' %}
	{% set current_theme = 'dark' %}
{% endif %}
<!doctype html>
<html lang="{% if current_lang %}{{ current_lang }}{% else %}ru{% endif %}" class="{{ current_theme }}" data-theme="{{ current_theme }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% if title %}{{ title }} | {% endif %}{{ _cfg.Sys_SiteName }}</title>
		<base href="{{ root_url }}">
		<link rel="icon" type="image/svg+xml" href="favicon.svg">
		<link rel="stylesheet" href="static/lib/fonts/inter/5.3.0/font.css">
		<link rel="stylesheet" href="static/lib/fonts/jetbrains-mono/5.3.0/font.css">
		<link rel="stylesheet" href="static/lib/fontawesome/6.5.1/css/all.min.css">
			<link rel="stylesheet" type="text/css" href="static/css/app.css?v=tailwind-20261016-account-ui2">
		<link rel="stylesheet" href="static/css/htmx-indicator.css?v=20260929-csp1">
		<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false}'>
		<script src="static/js/htmx.min.js"></script>
		<script src="static/js/app.js?v=20261016-payment-status1" defer></script>
	</head>
	<body class="min-h-screen bg-bgLight text-brand antialiased dark:bg-[#0A0A0A] dark:text-gray-100" hx-boost="false">
	{% if tpl_info %}
		{% include "external/info.twig" with {"_info": tpl_info} %}
	{% endif %}
