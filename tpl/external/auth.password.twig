{% if not isset(password_name) %}{% set password_name = 'Pass' %}{% endif %}
{% if not isset(password_id) %}{% set password_id = password_name %}{% endif %}
{% if not isset(password_placeholder) %}{% set password_placeholder = _t({"key": 'auth.placeholder.password', "default": '••••••••'}) %}{% endif %}
{% if not isset(password_autocomplete) %}{% set password_autocomplete = 'current-password' %}{% endif %}
{% if not isset(password_focus_class) %}{% set password_focus_class = 'focus:border-blue-500 focus:ring-blue-500/10 dark:focus:border-blue-500 dark:focus:ring-blue-500/20' %}{% endif %}
{% set password_toggle_id = password_id ~ '_show' %}
<div class="relative">
	<input id="{{ password_toggle_id }}" type="checkbox" class="peer sr-only" aria-label="{{ _t({"key": 'auth.password.show', "default": 'Показать пароль'}) }}">
	<input name="{{ password_name }}" id="{{ password_id }}" value="" type="text" placeholder="{{ password_placeholder }}" class="w-full rounded-2xl border border-black/10 bg-white px-5 py-4 pr-14 font-medium text-brand [-webkit-text-security:disc] outline-none transition placeholder:text-gray-400 focus:ring-4 peer-checked:[-webkit-text-security:none] dark:border-white/10 dark:bg-[#151515] dark:text-white dark:placeholder:text-gray-500 {{ password_focus_class }}" autocomplete="{{ password_autocomplete }}">
	<label for="{{ password_toggle_id }}" class="absolute right-4 top-1/2 flex h-9 w-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full text-gray-400 transition hover:bg-gray-100 hover:text-gray-600 peer-checked:text-blue-500 peer-focus-visible:ring-4 peer-focus-visible:ring-blue-500/20 dark:hover:bg-white/10 dark:hover:text-gray-300" title="{{ _t({"key": 'auth.password.show', "default": 'Показать пароль'}) }}" aria-label="{{ _t({"key": 'auth.password.show', "default": 'Показать пароль'}) }}">
		<i class="fa-solid fa-eye" aria-hidden="true"></i>
	</label>
</div>
