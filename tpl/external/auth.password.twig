{% if not isset(password_name) %}{% set password_name = 'Pass' %}{% endif %}
{% if not isset(password_id) %}{% set password_id = password_name %}{% endif %}
{% if not isset(password_placeholder) %}{% set password_placeholder = _t({"key": 'auth.placeholder.password', "default": '••••••••'}) %}{% endif %}
{% if not isset(password_autocomplete) %}{% set password_autocomplete = 'current-password' %}{% endif %}
{% if not isset(password_focus_class) %}{% set password_focus_class = 'focus:border-blue-500 focus:ring-blue-500/10 dark:focus:border-blue-500 dark:focus:ring-blue-500/20' %}{% endif %}
{% if not isset(password_show_label) %}{% set password_show_label = _t({"key": 'auth.password.show', "default": 'Показать пароль'}) %}{% endif %}
{% if not isset(password_hide_label) %}{% set password_hide_label = _t({"key": 'auth.password.hide', "default": 'Скрыть пароль'}) %}{% endif %}
{% set password_toggle_id = password_id ~ '_show' %}
<div class="relative">
	<input name="{{ password_name }}" id="{{ password_id }}" value="" type="password" placeholder="{{ password_placeholder }}" class="w-full rounded-2xl border border-black/10 bg-white px-5 py-4 pr-14 font-medium text-brand outline-none transition placeholder:text-gray-400 focus:ring-4 dark:border-white/10 dark:bg-[#151515] dark:text-white dark:placeholder:text-gray-500 {{ password_focus_class }}" autocomplete="{{ password_autocomplete }}">
	<button id="{{ password_toggle_id }}" type="button" data-hs-password-toggle aria-controls="{{ password_id }}" aria-label="{{ password_show_label }}" aria-pressed="false" data-show-label="{{ password_show_label }}" data-hide-label="{{ password_hide_label }}" class="absolute right-4 top-1/2 flex h-9 min-h-0 w-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border-0 p-0 text-gray-400 shadow-none transition hover:transform-none hover:bg-gray-100 hover:text-gray-600 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/20 dark:hover:bg-white/10 dark:hover:text-gray-300" title="{{ password_show_label }}">
		<i class="fa-solid fa-eye" data-hs-password-icon aria-hidden="true"></i>
	</button>
</div>
