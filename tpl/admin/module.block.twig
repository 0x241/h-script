

{% if modules %}
	{% set admin_category_default = _t({"key": 'admin.category.default'}) %}
	<div class="mb-4 mt-9 flex items-center justify-between border-b border-gray-200 pb-3 dark:border-gray-800">
		<h2 class="flex items-center gap-3 text-xl font-extrabold text-brand dark:text-white">
			<i class="fa-solid fa-folder-tree text-blue-500" aria-hidden="true"></i>
			{% if modules_cat %}{{ modules_cat }}{% else %}{{ admin_category_default }}{% endif %}
		</h2>
	</div>

	<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
		{% for n, m in modules %}
			<a class="group flex items-center justify-between gap-4 rounded-[1.5rem] border border-gray-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg dark:border-gray-800 dark:bg-[#151515] dark:hover:border-blue-500/30" href="{{ _link(m, false, 0) }}">
				<div class="flex min-w-0 items-center gap-4">
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gray-100 text-brand transition group-hover:bg-blue-50 group-hover:text-blue-500 dark:bg-[#1A1A1A] dark:text-white dark:group-hover:bg-blue-500/10 dark:group-hover:text-blue-300">
						{% include "icon.twig" with {"module": m} %}
					</span>
					<strong class="truncate text-sm font-extrabold text-brand dark:text-white">{{ n }}</strong>
				</div>
				<div class="flex shrink-0 items-center gap-3">
					{% if (m == 'balance/admin/opers' or m == 'balance/admin/index' or m == 'balance/admin/oper') and count_aopers > 0 %}
						<span class="rounded-full bg-red-500 px-2.5 py-1 text-xs font-extrabold text-white">{{ count_aopers }}</span>
					{% endif %}
					<i class="fa-solid fa-chevron-right text-gray-400 transition group-hover:translate-x-0.5 group-hover:text-blue-500" aria-hidden="true"></i>
				</div>
			</a>
		{% endfor %}
	</div>
{% endif %}

