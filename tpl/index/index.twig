<pre><span class="text-[#569CD6]">class</span> <span class="text-[#4EC9B0]">CatalogCache</span>
{
    <span class="text-[#569CD6]">public</span> <span class="text-[#569CD6]">function</span> <span class="text-[#DCDCAA]">remember</span>(
        <span class="text-[#569CD6]">string</span> $catalog,
        <span class="text-[#569CD6]">string</span> $variant,
        <span class="text-[#569CD6]">callable</span> $callback
    ): <span class="text-[#569CD6]">mixed</span>
    {
        $this-><span class="text-[#DCDCAA]">assertCatalog</span>($catalog);
        $version = $this-><span class="text-[#DCDCAA]">version</span>($catalog);
        $key = <span class="text-[#DCDCAA]">sprintf</span>(
            <span class="text-[#CE9178]">'catalog:%s:v%d:%s'</span>,
            $catalog,
            $version,
            <span class="text-[#DCDCAA]">hash</span>(<span class="text-[#CE9178]">'sha256'</span>, $variant)
        );
        <span class="text-[#569CD6]">return</span> $this->cache-><span class="text-[#DCDCAA]">get</span>(
            $key,
            $callback,
            <span class="text-[#569CD6]">self</span>::TTL[$catalog]
        );
    }
}</pre>
