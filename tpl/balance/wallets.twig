{% include "header.twig" with {"title": _t({"key": 'wallets.title', "default": 'Платежные реквизиты'})} %}

{% set wallets_form_name = getFormName('') %}
{% set wallets_info = getInfoData(wallets_form_name) %}

{% include 'balance/archived.holdings.twig' %}

{% if not wfields %}
	<div class="mx-auto w-full max-w-4xl">
		<div class="rounded-[1.5rem] border border-gray-100 bg-white p-10 text-center shadow-sm dark:border-gray-800 dark:bg-[#151515]">
			<div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100 text-2xl text-gray-400 dark:bg-[#202020]">
				<i class="fa-solid fa-wallet" aria-hidden="true"></i>
			</div>
			<h2 class="text-2xl font-bold text-brand dark:text-white">{{ _t({"key": 'wallets.empty.title', "default": 'Платежные системы не подключены'}) }}</h2>
			<p class="mx-auto mt-2 max-w-xl text-sm text-gray-500">{{ _t({"key": 'wallets.empty.text', "default": 'В данный момент администратор не активировал платежные шлюзы для ввода реквизитов.'}) }}</p>
		</div>
	</div>
{% else %}
    {% set wallet_controls = {} %}
	{% if _cfg.Const_IntCurr %}
		{% set wallet_controls = merge_arrays({'DefCurr': {0: 'S', 1: _t({"key": 'wallets.default_psys', "default": 'Плат. система по умолчанию!!'}), 2: {'psys_wrong': _t({"key": 'wallets.error.psys_wrong', "default": 'укажите плат.систему'})}, 3: merge_arrays({0: _t({"key": 'form.select', "default": '- выберите -'})}, defcurr), 'default': user.aDefCurr}}, wallet_controls) %}
	{% endif %}

	{% if showbutton and (_cfg.Sec_MinPIN > 0) %}
		{% set wallet_controls = array_append(wallet_controls|default([]), '') %}
		{% set wallet_controls = array_set_path(wallet_controls|default([]), ['PIN'], {0: '*', 1: _t({"key": 'wallets.pin', "default": 'Введите PIN-код!!<<чтобы подтвердить изменения>>'}), 2: {'pin_wrong': _t({"key": 'account.error.pin_wrong', "default": 'неверный код'})}, 'size': 8}) %}
	{% endif %}

	<div class="w-full min-w-0">
		<div class="mb-8">
			<h2 class="mb-2 text-3xl font-bold text-brand dark:text-white">{{ _t({"key": 'wallets.heading', "default": 'Платежные реквизиты'}) }}</h2>
			<p class="text-textDim dark:text-gray-400">{{ _t({"key": 'wallets.text', "default": 'Настройте адреса ваших кошельков для вывода заработанных средств.'}) }}</p>
		</div>

        {% if wallet_save_failed|default(false) %}<div role="alert" class="mb-8 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm font-semibold text-red-900 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-100">{{ _t({'key':'wallets.error.save_failed','default':'Не удалось сохранить реквизиты. Изменения отменены. Обновите страницу и повторите попытку.'}) }}</div>{% endif %}

		{% if wallets_info %}
			{% include "info.messages.twig" %}
			{% if info_msg[wallets_info[0]] %}
				<div class="mb-8 rounded-[1.5rem] border p-5 {% if substr(wallets_info[0], 0, 1) == '*' %}border-red-200 bg-red-50 text-red-900 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-100{% else %}border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-100{% endif %}">
					<div class="flex items-center gap-3 font-bold">
						<i class="fa-solid {% if substr(wallets_info[0], 0, 1) == '*' %}fa-circle-exclamation{% else %}fa-circle-check{% endif %}" aria-hidden="true"></i>
						{{ info_msg[wallets_info[0]] }}
					</div>
				</div>
			{% endif %}
		{% endif %}

		<div class="flex flex-col gap-8 lg:flex-row">
			<div class="min-w-0 flex-1">
				<form method="post" action="{{ _selfLink }}" name="{{ wallets_form_name }}" class="space-y-6">
					{{ _getFormSecurity({"form": wallets_form_name}) }}
					<div class="space-y-6">
                    {% for kind, provider in wallet_groups %}
                        <details class="group rounded-[1.5rem] border border-gray-100 bg-white shadow-sm dark:border-gray-800 dark:bg-[#151515]" data-wallet-provider="{{ kind }}"{% if wallet_groups|count == 1 %} open{% endif %}>
                            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-[1.5rem] px-4 py-4 focus-visible:outline-2 focus-visible:outline-blue-500 sm:px-6 [&::-webkit-details-marker]:hidden">
                                <h3 class="flex min-w-0 flex-1 items-center gap-3 text-lg font-bold"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400"><i class="fa-solid fa-plug" aria-hidden="true"></i></span><span class="min-w-0 [overflow-wrap:anywhere]">{{ provider.name }}</span></h3>
                                <span class="flex shrink-0 items-center gap-3"><span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-500 dark:bg-gray-800">{{ _t({'key':'wallets.group.currencies','default':'Валют'}) }}: {{ provider.currencies|count }}</span><i class="fa-solid fa-chevron-down text-xs text-gray-400 transition-transform group-open:rotate-180" aria-hidden="true"></i></span>
                            </summary>
                            <div class="space-y-5 border-t border-gray-100 p-5 dark:border-gray-800">
                                {% for network,section in provider.sections %}
                                    <section class="min-w-0 space-y-3" data-wallet-network="{{ network }}">
                                        {% if section.label %}<h4 class="flex items-center gap-2 text-sm font-bold text-gray-500"><i class="fa-solid fa-network-wired" aria-hidden="true"></i>{{ section.label }}</h4>{% endif %}
                                        {% for currency in section.currencies %}
                                            <section class="hs-wallet-currency" data-wallet-currency="{{ currency.id }}">
                                                <header><h5>{{ currency.code }}</h5><span>{{ currency.name }}</span></header>
                                                <div class="grid min-w-0 grid-cols-1 gap-5 p-5 sm:grid-cols-2">
                                                    {% include 'balance/wallets.fields.twig' with {'wfields':currency.fields,'wallet_section':'','wallet_compact':true,'wallet_kind':kind} %}
                                                </div>
                                            </section>
                                        {% endfor %}
                                    </section>
                                {% endfor %}
                            </div>
                        </details>
                    {% endfor %}
                    {% if wallet_controls %}<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">{% include 'balance/wallets.fields.twig' with {'wfields':wallet_controls,'wallet_section':''} %}</div>{% endif %}
					</div>

					{% set lost_wallet_error = formErrorText(wallets_form_name) %}
					{% if lost_wallet_error %}
						<div class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-900 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-100">{{ lost_wallet_error }}</div>
					{% endif %}

					{% if showbutton %}
						<div class="flex justify-end pt-8">
							<button name="{{ wallets_form_name }}_btn" value="{{ _t({"key": 'wallets.save', "default": 'Сохранить реквизиты'}) }}" type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-brand px-10 py-4 text-lg font-bold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-black dark:bg-white dark:text-brand dark:hover:bg-gray-100 sm:w-auto">
								<i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
								{{ _t({"key": 'wallets.save', "default": 'Сохранить реквизиты'}) }}
							</button>
						</div>
					{% endif %}
				</form>
			</div>

			<aside class="w-full shrink-0 lg:w-80">
				<div class="sticky top-28 rounded-[1.5rem] border border-gray-100 bg-gray-50/50 p-6 dark:border-gray-800 dark:bg-[#151515]">
					<h3 class="mb-6 text-lg font-bold text-brand dark:text-white">{{ _t({"key": 'wallets.security.title', "default": 'Правила безопасности'}) }}</h3>
					<div class="space-y-6">
						<div class="flex gap-4">
							<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600"><i class="fa-solid fa-shield-halved text-sm" aria-hidden="true"></i></div>
							<div>
								<div class="mb-1 text-sm font-bold text-brand dark:text-white">{{ _t({"key": 'wallets.security.verify', "default": 'Верификация изменений'}) }}</div>
								<div class="text-xs text-gray-500">{{ _t({"key": 'wallets.security.verify_text', "default": 'Любое изменение кошельков подтверждается вашим секретным PIN-кодом.'}) }}</div>
							</div>
						</div>
						<div class="flex gap-4">
							<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-100 text-blue-600"><i class="fa-solid fa-user-check text-sm" aria-hidden="true"></i></div>
							<div>
								<div class="mb-1 text-sm font-bold text-brand dark:text-white">{{ _t({"key": 'wallets.security.addresses', "default": 'Контроль адресов'}) }}</div>
								<div class="text-xs text-gray-500">{{ _t({"key": 'wallets.security.addresses_text', "default": 'Убедитесь в правильности сети. Транзакции в блокчейне необратимы.'}) }}</div>
							</div>
						</div>
						<div class="flex gap-4">
							<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-100 text-orange-600"><i class="fa-solid fa-bolt text-sm" aria-hidden="true"></i></div>
							<div>
								<div class="mb-1 text-sm font-bold text-brand dark:text-white">{{ _t({"key": 'wallets.security.payouts', "default": 'Регламент выплат'}) }}</div>
								<div class="text-xs text-gray-500">{{ _t({"key": 'wallets.security.payouts_text', "default": 'После привязки счета вы сможете заказывать выплаты в автоматическом режиме.'}) }}</div>
							</div>
						</div>
					</div>
				</div>
			</aside>
		</div>
	</div>
{% endif %}

{% include "footer.twig" %}
