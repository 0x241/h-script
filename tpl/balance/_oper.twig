{% set s1 = 'Batch-номер!!<<хеш операции/транзакции>>' %}
{% set s2 = 'укажите номер операции' %}
{% set s3 = 'номер используется' %}

<section class="hs-admin-oper-summary">
	<header><div><span class="hs-payment-eyebrow">{{ _t({'key':'balance.oper.number'}) }} #{{ el.oID }}</span><h2>{{ _t({'key':'admin.oper.details'}) }}</h2></div><span class="hs-admin-oper-state" data-operation-state="{{ el.oState }}">{{ op_statuses[el.oState] }}</span></header>
	<dl>
		<div><dt>{{ _t({'key':'common.date'}) }}</dt><dd>{{ el.oCTS }}</dd></div>
		<div><dt>{{ _t({'key':'admin.oper.owner'}) }}</dt><dd><a href="{{ _link('account/admin/user', false, 0) }}?id={{ el.uID }}">{{ el.uLogin }}</a></dd></div>
		<div><dt>{{ _t({'key':'admin.oper.type'}) }}</dt><dd>{{ op_names[el.oOper] }}</dd></div>
		<div><dt>{{ _t({'key':'balance.col.psys'}) }}</dt><dd><a href="{{ _link('balance/admin/curr', false, 0) }}?id={{ el.ocID }}">{{ el.cName }}</a></dd></div>
		<div><dt>{{ _t({'key':'balance.field.sum'}) }}</dt><dd class="font-mono">{{ _z(el.oSum, el.ocID, 1) }}</dd></div>
		{% if el.oComis != 0 %}<div><dt>{{ _t({'key':'opers.comis'}) }}</dt><dd class="font-mono">{{ _z(el.oComis, el.ocID, 1) }}</dd></div><div><dt>{{ op_sums[el.oOper] }}</dt><dd class="font-mono">{{ _z(el.oSum|decimal_subtract(el.oComis), el.ocID, 1) }}</dd></div>{% endif %}
		{% if el.oParams.uid2 %}<div><dt>{% if el.oOper == 'TR' %}{{ _t({'key':'balance.transfer.receiver'}) }}{% else %}{{ _t({'key':'balance.transfer.sender'}) }}{% endif %}</dt><dd><a href="{{ _link('account/admin/user', false, 0) }}?id={{ el.oParams.uid2 }}">{{ el.oParams.user }}</a></dd></div>{% endif %}
		{% if el.oParams.cid2 %}<div><dt>{{ _t({'key':'admin.oper.other_currency'}) }}</dt><dd>{{ el.oParams.psys }}</dd></div>{% endif %}
		{% if el.oParams.sum2 %}<div><dt>{{ _t({'key':'balance.sum2'}) }}</dt><dd>{% if el.oOper in ['EX','EXIN'] %}{{ exchange_quote.amount|default('—') }} {{ exchange_quote.currency }}{% else %}{{ _z(el.oParams.sum2, exValue(el.ocID, el.oParams.cid2), 1) }}{% endif %}</dd></div>{% endif %}
		{% if el.oParams2.acc %}<div><dt>{{ _t({'key':'balance.account'}) }}</dt><dd>{{ el.oParams2.acc }}</dd></div>{% endif %}
		{% if el.oBatch %}<div><dt>{{ _t({'key':'opers.col.batch'}) }}</dt><dd>{{ el.oBatch }}</dd></div>{% endif %}
		{% if el.oTS %}<div><dt>{{ _t({'key':'admin.oper.changed'}) }}</dt><dd>{{ el.oTS }}</dd></div>{% endif %}
		{% if el.oNTS %}<div><dt>{{ _t({'key':'admin.oper.processed'}) }}</dt><dd>{{ el.oNTS }}</dd></div>{% endif %}
		{% if el.oMemo %}<div class="hs-admin-oper-wide"><dt>{{ _t({'key':'opers.col.memo'}) }}</dt><dd>{{ el.oMemo }}</dd></div>{% endif %}
	</dl>
</section>

{% if (el.oState <= 2 or el.oState >= 4) and not ccapi_payout_attempted|default(false) %}
<div class="hs-admin-oper-layout">
	{% if el.oOper in ['CASHIN','CASHOUT'] and el.oState <= 2 %}
	<section class="hs-admin-oper-manual">
		<header><span class="hs-payment-eyebrow">{{ _t({'key':'admin.oper.step1'}) }}</span><h3>{{ _t({'key':'admin.oper.receipt'}) }}</h3><p>{{ _t({'key':'admin.oper.receipt_hint'}) }}</p></header>
		{% include 'balance/_oper.data.twig' with {'oComis': el.oOper == 'CASHOUT' ? el.oComis : 0} %}
	</section>
	{% endif %}
	<section class="hs-admin-oper-actions">
		<header><span class="hs-payment-eyebrow">{% if el.oOper in ['CASHIN','CASHOUT'] and el.oState <= 2 %}{{ _t({'key':'admin.oper.step2'}) }}{% endif %}</span><h3>{{ _t({'key':'admin.oper.decision'}) }}</h3><p>{{ _t({'key':'admin.oper.decision_hint'}) }}</p></header>
		{% if afields %}<p class="hs-admin-oper-api-note">{{ _t({'key':'admin.oper.api_hint'}) }}</p>{% endif %}
		{% include 'edit.twig' with {'title':'','fields': merge_arrays({'oID':el.oID}, afields|default([])), 'values':el, 'form_layout':'settings_grid', 'btn_text':bt, 'btns':b, 'hide_cancel':true} %}
	</section>
</div>
{% endif %}
