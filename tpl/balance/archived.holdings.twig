{% if archived_holdings|default(false) %}
<section class="mb-8 overflow-hidden rounded-2xl border border-amber-200 bg-white shadow-sm dark:border-amber-900 dark:bg-[#151515]" data-archived-holdings>
    <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800"><h3 class="flex items-center gap-2 text-lg font-bold"><i class="fa-solid fa-box-archive text-amber-600" aria-hidden="true"></i>{{ _t({'key':'balance.archive.title'}) }}</h3><p class="mt-2 text-sm text-gray-500">{{ _t({'key':'balance.archive.hint'}) }}</p></div>
    <div class="overflow-x-auto"><table class="w-full min-w-[640px] text-left text-sm"><thead><tr class="bg-gray-50 text-xs text-gray-500 dark:bg-[#1A1A1A]"><th class="px-5 py-3">{{ _t({'key':'balance.col.psys'}) }}</th><th class="px-5 py-3 text-right">{{ _t({'key':'balance.archive.amount'}) }}</th><th class="px-5 py-3 text-right">{{ _t({'key':'balance.col.locked'}) }}</th><th class="px-5 py-3 text-right">{{ _t({'key':'balance.col.pending'}) }}</th></tr></thead><tbody class="divide-y divide-gray-100 dark:divide-gray-800">{% for currency in archived_holdings %}<tr data-archived-currency="{{ currency.cID }}"><td class="px-5 py-3"><strong>{{ currency.cName }}</strong><small class="mt-1 block text-gray-500">{{ currency.cCurr|default(currency.cCurrID,true) }} · #{{ currency.cID }}</small></td><td class="whitespace-nowrap px-5 py-3 text-right font-mono font-bold">{{ currency.wBal }}</td><td class="whitespace-nowrap px-5 py-3 text-right font-mono">{{ currency.wLock }}</td><td class="whitespace-nowrap px-5 py-3 text-right font-mono">{{ currency.wOut }}</td></tr>{% endfor %}</tbody></table></div>
    <p class="px-5 py-4 text-sm text-gray-500">{{ _t({'key':'balance.archive.history'}) }} <a class="font-bold text-blue-600 underline" href="{{ _link('balance',false,0) }}">{{ _t({'key':'balance.history.title'}) }}</a></p>
</section>
{% endif %}
