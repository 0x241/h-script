
<div class="card balance-snapshot" style="padding: 32px; margin-top: 24px; background: linear-gradient(135deg, var(--color-surface) 0%, color-mix(in srgb, var(--color-accent) 15%, var(--color-surface)) 100%); border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border)); border-radius: var(--radius-lg); box-shadow: var(--shadow-glow);">
	<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: {% if curr1  or  user.uBal > 0 %}24px{% else %}0{% endif %};">
		<div>
			<span class="balance-snapshot__label" style="display: block; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin-bottom: 8px;">Текущий доступный баланс</span>
			{% if curr1 %}
				<strong class="balance-snapshot__value" style="font-family: var(--font-mono); font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 900; color: var(--color-primary-ink); text-shadow: 0 0 20px color-mix(in srgb, var(--color-accent) 30%, transparent);">
					{{ _z(curr1.wBal, curr1.cID, 2) }}
				</strong>
			{% elseif user.uBal == 0 %}
				<strong class="balance-snapshot__value" style="font-family: var(--font-mono); font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 900; color: var(--color-text-muted);">
					0.00
				</strong>
			{% endif %}
		</div>
		<span class="balance-snapshot__icon" aria-hidden="true" style="width: 72px; height: 72px; display: grid; place-items: center; background: color-mix(in srgb, var(--color-accent) 15%, transparent); color: var(--color-accent); font-size: 2.2rem; border-radius: var(--radius-md); border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent); box-shadow: 0 0 25px color-mix(in srgb, var(--color-accent) 30%, transparent);"><i class="fa-solid fa-vault"></i></span>
	</div>
	{% if not curr1  and  user.uBal > 0 %}
		<div class="balance-snapshot__table" style="width: 100%;">
			{% include "balance/bal.twig" %}
		</div>
	{% endif %}
</div>

