<section class="overflow-hidden rounded-[1.5rem] border border-gray-100 bg-white shadow-sm dark:border-gray-800 dark:bg-[#151515]" data-bank-payment>
    <div class="flex items-center gap-3 border-b border-gray-100 p-5 dark:border-gray-800"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400"><i class="fa-solid fa-building-columns" aria-hidden="true"></i></span><div><h3 class="text-lg font-bold">{{ _t({'key':'payment.bank.title','default':'Реквизиты для банковского перевода'}) }}</h3><p class="text-sm text-gray-500">{{ el.cName }}</p></div></div>
    <dl class="divide-y divide-gray-100 px-5 dark:divide-gray-800">
        {% for key,field in pfields|default([]) %}{% if pvalues[key]|default('') %}<div class="grid gap-2 py-4 sm:grid-cols-3"><dt class="text-sm font-semibold text-gray-500">{{ field[0] }}</dt><dd class="break-all font-mono text-sm font-semibold sm:col-span-2">{{ pvalues[key] }}</dd></div>{% endif %}{% endfor %}
        <div class="grid gap-2 py-4 sm:grid-cols-3"><dt class="text-sm font-semibold text-gray-500">{{ _t({'key':'balance.field.sum','default':'Сумма'}) }}</dt><dd class="font-mono text-lg font-bold sm:col-span-2">{{ _z(el.oSum,el.ocID,-1) }} {{ el.cCurrID }}</dd></div>
        <div class="grid gap-2 py-4 sm:grid-cols-3"><dt class="text-sm font-semibold text-gray-500">{{ _t({'key':'payment.bank.reference','default':'Номер операции'}) }}</dt><dd class="font-mono font-bold sm:col-span-2">#{{ el.oID }}</dd></div>
    </dl>
    <p class="flex items-start gap-3 border-t border-gray-100 bg-gray-50/50 p-5 text-sm text-gray-500 dark:border-gray-800 dark:bg-gray-800/30"><i class="fa-solid fa-circle-info mt-1" aria-hidden="true"></i><span>{{ _t({'key':'payment.bank.notice','default':'Укажите номер операции в назначении перевода. Зачисление выполнит администратор после проверки банковской выписки.'}) }}{% if not pvalues.acc|default('') and not pvalues.iban|default('') %} {{ _t({'key':'payment.bank.missing','default':'Реквизиты счёта пока не заполнены. Уточните их у поддержки перед переводом.'}) }}{% endif %}</span></p>
</section>
