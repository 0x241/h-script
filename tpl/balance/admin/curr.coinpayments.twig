<div class="hs-provider space-y-6">
    {% if coinnew_currency|default(false) or coinnew_token_page %}<a class="font-bold text-blue-600" href="{{ coinnew_url }}">{{ _t({'key':'gateway.admin.coinpayments_new_connection'}) }}</a>{% endif %}
    <div class="hs-provider-heading"><span class="hs-provider-icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></span><h2>CoinPayments NEW{% if coinnew_currency|default(false) %} · {{ coinnew_currency.symbol }}{% endif %}</h2><span class="hs-provider-badge {{ coinnew_profile.ppState|default('') == 'enabled' ? 'is-enabled':'is-disabled' }}"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>{{ coinnew_profile.ppID|default(false) ? (_t({'key':'gateway.admin.connection_saved'})):(_t({'key':'gateway.admin.new_connection'})) }}</span></div>
    {% if coinnew_error|default(false) %}<p role="alert" class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">{{ coinnew_error }}</p>{% endif %}
    <aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><div><strong>{{ _t({'key':'gateway.admin.catalog_and_connection_setup'}) }}</strong><p class="mt-2">{{ _t({'key':'gateway.admin.deposits_and_withdrawals_are_not_yet_available_completed_sandbox'}) }}</p></div></aside>
    {% if coinnew_currency|default(false) %}
    <section class="card hs-provider-panel space-y-4"><h3 class="font-bold">{{ coinnew_currency.name }}</h3><dl class="hs-provider-fields"><div><dt class="text-sm text-gray-500">{{ _t({'key':'gateway.admin.platform'}) }}</dt><dd>{{ coinnew_currency.instance }}</dd></div><div><dt class="text-sm text-gray-500">{{ _t({'key':'gateway.admin.network'}) }}</dt><dd>{{ coinnew_currency.network }}</dd></div><div><dt class="text-sm text-gray-500">{{ _t({'key':'gateway.admin.coinpayments_identifier'}) }}</dt><dd class="break-all font-mono">{{ coinnew_currency.id }}</dd></div><div><dt class="text-sm text-gray-500">{{ _t({'key':'gateway.admin.catalog_confirmation_count'}) }}</dt><dd>{{ coinnew_currency.confirmations }}</dd></div></dl>{% if coinnew_currency.contract %}<p class="text-sm text-gray-500">{{ _t({'key':'payment.native.contract'}) }}</p><code class="block break-all">{{ coinnew_currency.contract }}</code>{% endif %}<a class="font-bold text-blue-600" href="{{ _link('balance/admin/opers',false,0) }}?currency_id={{ coinnew_currency.currency_id }}">{{ _t({'key':'currency.operations'}) }}</a></section>
    {% else %}
    {% if coinnew_profile %}<nav class="flex flex-wrap gap-3" aria-label="{{ _t({'key':'gateway.admin.connection_section'}) }}"><a class="hs-provider-button{{ coinnew_token_page ? ' hs-provider-button--remove':'' }}" href="{{ coinnew_url }}">{{ _t({'key':'gateway.admin.connection_and_coins'}) }}</a><a class="hs-provider-button{{ coinnew_token_page ? '':' hs-provider-button--remove' }}" href="{{ coinnew_url }}&amp;tab=tokens">{{ _t({'key':'gateway.admin.tokens_by_network'}) }}</a></nav>{% endif %}
    {% if not coinnew_token_page %}
    <section class="card hs-provider-panel"><form method="post" action="{{ coinnew_url }}" name="coinnew_catalog" class="space-y-4">{{ _getFormSecurity({'form':'coinnew_catalog'}) }}<div class="hs-provider-section-title"><span>1</span><div><h3>{{ _t({'key':'gateway.admin.coin_and_token_catalog'}) }}</h3><p>{{ _t({'key':'gateway.admin.loaded_from_the_selected_platform_s_api_credentials_are'}) }}</p></div></div><label class="block"><span class="mb-2 block font-bold">{{ _t({'key':'gateway.admin.account_platform'}) }}</span><select class="hs-provider-input" name="instance" {% if coinnew_profile %}disabled{% endif %}>{% for value,label in {'A':'Instance A','B':'Instance B','C':'Instance C','SANDBOX':'Sandbox'} %}<option value="{{ value }}" {% if coinnew_instance == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% if coinnew_profile %}<input type="hidden" name="instance" value="{{ coinnew_instance }}">{% endif %}<button class="hs-provider-button" name="coinnew_catalog_btn" value="1" type="submit">{{ _t({'key':'gateway.admin.load_catalog'}) }}</button></form></section>
    {% endif %}
    <section class="card hs-provider-panel"><form method="post" action="{{ coinnew_url }}" id="coinnew-save" name="coinnew_save" class="space-y-6">{{ _getFormSecurity({'form':'coinnew_save'}) }}<input type="hidden" name="profile_id" value="{{ coinnew_profile.ppID|default(0) }}"><input type="hidden" name="revision" value="{{ coinnew_profile.ppRevision|default(0) }}"><input type="hidden" name="credentials[instance]" value="{{ coinnew_instance }}">{% if coinnew_token_page %}<input type="hidden" name="credentials[client_id]" value="{{ coinnew_client }}"><input type="hidden" name="enabled" value="{{ coinnew_profile.ppState == 'enabled' ? '1':'0' }}">{% else %}<div class="hs-provider-section-title"><span>2</span><div><h3>{{ _t({'key':'gateway.admin.coinpayments_new_access'}) }}</h3><p>{{ _t({'key':'gateway.admin.saving_verifies_read_only_api_access_no_wallets_invoices'}) }}</p></div></div><div class="hs-provider-fields"><label><span class="mb-2 block font-bold">{{ _t({'key':'gateway.field.client_id'}) }} · {{ coinnew_instance }}</span><input class="hs-provider-input" name="credentials[client_id]" value="{{ coinnew_client }}" autocomplete="off" {% if coinnew_profile %}readonly{% endif %}></label><label><span class="mb-2 block font-bold">{{ _t({'key':'gateway.field.client_secret'}) }}</span><input class="hs-provider-input" name="credentials[client_secret]" type="password" autocomplete="new-password" placeholder="{{ coinnew_profile ? (_t({'key':'gateway.admin.saved_leave_blank_to_keep_unchanged'})):(_t({'key':'gateway.admin.enter_integration_secret'})) }}"></label></div><label class="hs-provider-enabled"><input type="hidden" name="enabled" value="0"><input type="checkbox" name="enabled" value="1" {% if not coinnew_profile or coinnew_profile.ppState == 'enabled' %}checked{% endif %}><span>{{ _t({'key':'gateway.admin.connection_enabled'}) }}<small class="mt-1 block font-normal text-gray-500">{{ _t({'key':'gateway.admin.financial_modes_remain_off_until_payment_acceptance_is_verified'}) }}</small></span></label>{% endif %}
    <div data-token-catalog><div class="hs-provider-section-title"><span>3</span><div><h3>{{ coinnew_token_page ? (_t({'key':'gateway.admin.tokens_by_network'})):(_t({'key':'gateway.admin.native_coins'})) }}</h3><p>{{ _t({'key':'gateway.admin.only_selected_assets_are_added_to_the_database_their'}) }}</p></div></div>{% if coinnew_catalog %}<label class="mb-4 block"><span class="sr-only">{{ _t({'key':'gateway.admin.search_by_currency_network_or_contract'}) }}</span><input class="hs-provider-input" type="search" data-token-search placeholder="{{ _t({'key':'gateway.admin.search_by_currency_network_or_contract'}) }}"></label>{% for group,assets in coinnew_groups %}{% if group %}<h4 class="mb-3 mt-5 font-bold">{{ group }}</h4>{% endif %}<div class="hs-provider-currencies">{% for id,asset in assets %}{% set saved=coinnew_selected[id]|default(null) %}<div class="hs-provider-currency" data-token-option><label class="flex items-start gap-3"><input type="checkbox" name="assets[]" value="{{ asset.id }}" {% if saved.selected|default(false) %}checked{% endif %} {% if not asset.selectable %}disabled{% endif %}><span class="min-w-0"><strong>{{ asset.symbol }}</strong><span class="block text-sm text-gray-500">{{ asset.network }} · {{ asset.name }}</span><small class="mt-1 block break-all font-mono">{{ asset.contract|default(asset.id,true) }}</small>{% if asset.status == 'underMaintenance' %}<small class="mt-2 block text-amber-700">{{ _t({'key':'gateway.admin.under_maintenance_at_coinpayments'}) }}</small>{% elseif asset.status == 'saved' %}<small class="mt-2 block text-gray-500">{{ _t({'key':'gateway.admin.saved_currency_load_the_current_catalog'}) }}</small>{% elseif not asset.selectable %}<small class="mt-2 block text-amber-700">{{ _t({'key':'gateway.admin.unavailable_for_this_platform'}) }}</small>{% endif %}</span></label>{% if saved %}<a class="mt-3 block font-bold text-blue-600" href="{{ _link('balance/admin/curr',false,0) }}?id={{ saved.currency_id }}">{{ _t({'key':'gateway.admin.open_currency'}) }}{{ saved.currency_id }}</a>{% endif %}</div>{% endfor %}</div>{% endfor %}{% else %}<p class="hs-provider-note">{{ _t({'key':'gateway.admin.load_the_selected_platform_s_catalog_to_choose_coins'}) }}</p>{% endif %}</div>
    {% for id,asset in coinnew_hidden %}{% if coinnew_selected[id].selected|default(false) %}<input type="hidden" name="assets[]" value="{{ asset.id }}">{% endif %}{% endfor %}
    <aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.this_saves_currency_selection_for_the_entire_connection_selected'}) }}</p></aside>
    <input type="hidden" name="form_complete" value="1"></form><div class="hs-provider-actions"><button form="coinnew-save" class="hs-provider-button" type="submit" name="coinnew_save_btn" value="1">{{ _t({'key':'gateway.admin.verify_access_and_save'}) }}</button>{% if coinnew_profile and not coinnew_token_page %}<form method="post" action="{{ coinnew_url }}" name="coinnew_disable">{{ _getFormSecurity({'form':'coinnew_disable'}) }}<input type="hidden" name="profile_id" value="{{ coinnew_profile.ppID }}"><input type="hidden" name="revision" value="{{ coinnew_profile.ppRevision }}"><input type="hidden" name="retire" value="1"><button class="button" name="coinnew_disable_btn" value="1" type="submit">{{ _t({'key':'gateway.admin.archive_gateway_and_all_its_currencies'}) }}</button></form>{% endif %}</div></section>
    {% endif %}
</div>
