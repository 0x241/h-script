{% set financial_form = true %}

{% include "admin/header.twig" with {"title": 'Операция'} %}

{% include "balance/_statuses.twig" %}

{% if el %}
{% if ccapi_payout_attempted|default(false) %}<aside class="mb-5 rounded-xl border border-blue-200 bg-blue-50 p-5 dark:border-blue-900 dark:bg-blue-950"><strong>Выплата CCAPI: {{ ccapi_payout_reconciliation|default(false) ? 'требует сверки' : (el.oState == 3 ? 'подтверждена':'ожидает подтверждения') }}</strong><p class="mt-2 text-sm">Повторная отправка и ручное изменение реквизитов заблокированы. Проверка запрашивает статус исходной заявки; для токена требуется подписанное подтверждение с контрактом.</p><form method="post" class="mt-4">{{ _getFormSecurity({'form':'ccapi_payout_check'}) }}{{ _financialFormFields() }}<input type="hidden" name="payout_id" value="{{ el.oID }}"><button type="submit" name="ccapi_payout_check_btn" value="1" class="hs-provider-button">Проверить выплату</button></form></aside>{% endif %}
{% if paw_payout_attempted|default(false) %}<aside class="mb-5 rounded-xl border border-blue-200 bg-blue-50 p-5 dark:border-blue-900 dark:bg-blue-950"><strong>Выплата PAW: {{ paw_payout_reconciliation|default(false) ? 'требует сверки' : (el.oState == 3 ? 'подтверждена':'ожидает подтверждения') }}</strong><p class="mt-2 text-sm">PAW конвертирует исходную сумму в выбранный стейблкоин. Проверяется только сохранённая заявка PAW. Повторная отправка, отмена и изменение реквизитов после попытки заблокированы.</p><form method="post" class="mt-4">{{ _getFormSecurity({'form':'paw_payout_check'}) }}{{ _financialFormFields() }}<input type="hidden" name="payout_id" value="{{ el.oID }}"><button type="submit" name="paw_payout_check_btn" value="1" class="hs-provider-button">Проверить выплату</button></form></aside>{% endif %}
{% if ccapi_payout_sources|default(false) %}<section class="mb-5 rounded-xl border border-gray-200 p-4 text-sm"><strong>Кошельки — источники выплат</strong><p class="mt-2 text-gray-500">Проверьте сеть реквизитов получателя перед отправкой.</p><dl class="mt-3 space-y-2">{% for source in ccapi_payout_sources %}<div><dt class="font-bold">{{ source.network }}</dt><dd class="break-all font-mono">{{ source.address }}</dd></div>{% endfor %}</dl></section>{% endif %}


	{% set b = [] %}
	{% if el.oState <= 2 and not ccapi_payout_attempted|default(false) and not paw_payout_attempted|default(false) %}
		{% set b = array_set_path(b|default([]), ['cancel'], 'Отклонить') %}
	{% endif %}
	{% if el.oState >= 4 %}
		{% set b = array_set_path(b|default([]), ['del'], 'Удалить') %}
	{% endif %}
	{% include "balance/_oper.twig" with {"bt": valueIf(el.oState <= 2 and not ccapi_payout_attempted|default(false) and not paw_payout_attempted|default(false), 'Выполнить', ' '), "b": b, "errors": {'ex_sum_wrong': _t({'key': 'opers.error.sum_wrong'}), 'ex_overflow': _t({'key': 'opers.error.amount_range'}), 'sum_precision': _t({'key': 'opers.error.amount_precision'}), 'sum_overflow': _t({'key': 'opers.error.amount_range'}), 'bal_precision': _t({'key': 'opers.error.amount_precision'}), 'bal_overflow': _t({'key': 'opers.error.amount_range'}), 'oper_not_found': 'неверный статус операции', 'oper_disabled': 'операция отключена', 'low_bal1': 'недостаточно средств', 'data_date_wrong': 'неверная дата операции', 'data_sum_wrong': 'неверная сумма', 'data_batch_wrong': 'не задан batch-номер операции', 'batch_exists': 'операция с таким batch-номером уже существует', 'send_error': 'ошибка при отправке средств'}, "from_admin": true, "op_statuses": op_statuses, "op_sums": op_sums} %}
	
{% else %}

	{% if _GET.add %}
	
		{% set oper = _GET.add %}
		{% set use_sum2 = in_array(oper, ['CASHIN', 'CASHOUT', 'EX', 'TR', 'SELL']) %}
		{% set preview_url = _link('ajax', false, 0) ~ '?module=balance&do=getsum&format=html' %}
		{% set admin_oper_fields = {
			'Oper': oper,
			'Login': _GET.user,
			'User': ['X', 'Пользователь', 0, _GET.user],
			'Bal': ['U', 'balance/bal.twig'],
			'PSys': {
				0: 'S',
				1: valueIf(oper == 'CALCIN', 'Плат. система!!или Депозит!!', 'Плат. система!!'),
				2: {'depo_wrong': 'неверный депозит', 'psys_empty': 'плат. система не указана'},
				3: merge_arrays(valueIf(count(clist) > 1, {0: '- выберите -'}, []), clist),
				'hx_post': preview_url,
				'hx_trigger': 'change',
				'hx_target': '#admin-operation-preview-content',
				'hx_swap': 'outerHTML',
				'hx_include': 'closest form',
				'hx_sync': 'closest form:replace'
			},
			'Sum': {
				0: '$',
				1: valueIf(_cfg.Const_IntCurr and in_array(oper, ['CASHOUT']), 'Сумма!!<<в ед. внутр. валюты>>', 'Сумма!!'),
				2: {'ex_sum_wrong': _t({'key': 'opers.error.sum_wrong'}), 'ex_overflow': _t({'key': 'opers.error.amount_range'}), 'sum_precision': _t({'key': 'opers.error.amount_precision'}), 'sum_overflow': _t({'key': 'opers.error.amount_range'}), 'bal_precision': _t({'key': 'opers.error.amount_precision'}), 'bal_overflow': _t({'key': 'opers.error.amount_range'}), 'sum_wrong': 'неверная сумма'},
				'hx_post': preview_url,
				'hx_trigger': 'input changed delay:250ms',
				'hx_target': '#admin-operation-preview-content',
				'hx_swap': 'outerHTML',
				'hx_include': 'closest form',
				'hx_sync': 'closest form:replace'
			},
			'PSys2': {
				0: 'S',
				1: valueIf(oper == 'EX', 'На плат. систему!!', 'С плат. системы!!'),
				2: {'psys2_empty': 'плат.система не указана', 'psys2_equal_psys': 'плат.системы должны различаться'},
				3: merge_arrays(valueIf(count(clist) > 1, {0: '- выберите -'}, []), clist),
				'skip': oper != 'EX',
				'hx_post': preview_url,
				'hx_trigger': 'change',
				'hx_target': '#admin-operation-preview-content',
				'hx_swap': 'outerHTML',
				'hx_include': 'closest form',
				'hx_sync': 'closest form:replace'
			},
			'Preview': {0: 'U', 1: 'balance/admin/sum.preview.shell.twig', 'skip': not use_sum2},
			'Login2': {0: 'T', 1: valueIf(oper == 'TR', 'Получатель!!', 'Отправитель!!'), 2: {'user2_empty': 'пользователь не найден', 'user2_equal_user': 'пользователи должны различаться'}, 'skip': not in_array(oper, ['TR', 'TRIN'])},
			'Memo': {0: 'W', 1: 'Описание', 'size': 4}
		} %}
		<div class="card hs-oper-card">
		{% include "edit.twig" with {"form": 'add', "title": op_names[oper], "fields": admin_oper_fields, "errors": {'ex_sum_wrong': _t({'key': 'opers.error.sum_wrong'}), 'ex_overflow': _t({'key': 'opers.error.amount_range'}), 'sum_precision': _t({'key': 'opers.error.amount_precision'}), 'sum_overflow': _t({'key': 'opers.error.amount_range'}), 'bal_precision': _t({'key': 'opers.error.amount_precision'}), 'bal_overflow': _t({'key': 'opers.error.amount_range'}), 'oper_disabled': 'операция отключена'}} %}
		</div>
	
	{% else %}
	
		<div class="card hs-oper-card">
		{% include "edit.twig" with {"form": 'add', "title": 'Новая операция', "fields": {'Oper': ['S', 'Операция!!', {'oper_empty': 'операция не указана', 'oper_wrong': 'неизвестная операция'}, merge_arrays({0: '- выберите -'}, op_names)], 'Login': {0: 'T', 1: 'Пользователь!!', 2: {'user_empty': 'пользователь не найден'}, 'default': _GET.user}}, "btn_text": 'Далее'} %}
		</div>
		
	{% endif %}
	
{% endif %}

{% include "admin/footer.twig" %}
