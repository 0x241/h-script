{% if currency_shared_provider|default(false) and (provider_kind in ['STRIPE','CCAPI'] or values.cCID|default('') in ['PKTU','PKTC'] or (provider_kind == 'VOLET' and values.cCID|default('') != 'AC')) %}
    {% set params=params|merge({'cCASHOUTMode':{0:'S',1:'Режим',2:[],3:{0:'отключён',1:'ручной'}}}) %}
{% endif %}
{% if values.cCID|default('') == 'CCT' %}{% set params=params|merge({'cEXMode':{0:'S',1:'Режим',2:[],3:{0:'отключён'},'comment':'Токен учитывается отдельно по сети и контракту. Автоматического обмена по курсу его символа нет.'},'cGIVEMode':{0:'S',1:'Режим',2:[],3:{0:'отключён'},'comment':'Депозитные планы для этого токена не подключены.'},'cTAKEMode':{0:'S',1:'Режим',2:[],3:{0:'отключено'}}}) %}{% endif %}
{% set currency_fields = merge_arrays(fields, params) %}
{% if currency_preview|default(false) %}
    {% for key, field in currency_fields %}
        {% if field is iterable and field[0]|default('') %}
            {% set field = field|merge({'readonly':true,'disabled':true}) %}
            {% if field[0] in ['I','$','%','C'] %}{% set field = field|merge({'default':0}) %}{% endif %}
            {% if values.cCID|default('') == 'CCT' %}{% set params=params|merge({'cEXMode':{0:'S',1:'Режим',2:[],3:{0:'отключён'},'comment':'Токен учитывается отдельно по сети и контракту. Автоматического обмена по курсу его символа нет.'},'cGIVEMode':{0:'S',1:'Режим',2:[],3:{0:'отключён'},'comment':'Депозитные планы для этого токена не подключены.'},'cTAKEMode':{0:'S',1:'Режим',2:[],3:{0:'отключено'}}}) %}{% endif %}
{% set currency_fields = currency_fields|merge({(key):field}) %}
        {% endif %}
    {% endfor %}
    {% include 'admin/edit.block.twig' with {'fields':currency_fields,'form_layout':'','edit_is_filter':false,'edit_is_settings':false} %}
{% else %}
    {% include 'edit.twig' with {'fields':currency_fields} %}
{% endif %}
