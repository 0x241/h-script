а', 'cBUYMode': ['S', 'Режим', 0, {0: 'отключена', 1: 'ручной', 2: 'мгновенно'}], 1: 'Продажа', 'cSELLMode': ['S', 'Режим', 0, {0: 'отключена', 1: 'ручной', 2: 'мгновенно'}], 2: 'Услуга', 'cBUY2Mode': ['S', 'Режим', 0, {0: 'отключена', 1: 'ручной', 2: 'мгновенно'}], 3: 'Оказание услуги', 'cSELL2Mode': ['S', 'Режим', 0, {0: 'отключено', 1: 'ручной', 2: 'мгновенно'}], 4: 'Вклад', 'cGIVEMode': ['S', 'Режим', 0, {0: 'отключен', 1: 'ручной', 2: 'мгновенно'}], 9: 'Снятие', 'cTAKEMode': ['S', 'Режим', 0, {0: 'отключено', 1: 'ручной', 2: 'мгновенно'}]} %}
{% if currency_provider_paw|default(false) %}
    {% set params = params|merge({'cBal':{0:'X',1:'Последнее значение','default':'Недоступен — финансовая обработка PAW ещё не подключена'},'cCASHINMode': {0:'S', 1:'Режим', 2:[], 3:{0:'отключено'}, 'readonly':true, 'comment':'Приём PAW станет доступен после проверки финансовой обработки.'}, 'cCASHOUTMode': {0:'S', 1:'Режим', 2:[], 3:{0:'отключён'}, 'readonly':true, 'comment':'Вывод через PAW ещё недоступен.'}}) %}
