
<td>
	{{ l.cID }}
</td>
<td class="nowrap">
	{{ l.presentation.code|default(l.cCID) }} {{ l.presentation.asset|default(l.cCurrID) }}
    {% if l.currency_status == 'retired' %}<small class="mt-1 block font-semibold text-gray-500">{{ _t({'key':'currency.archived','default':'Архив'}) }} · #{{ l.cID }}</small>{% endif %}
    {% if l.presentation.contract|default(false) %}<small class="mt-1 block font-mono text-gray-500" title="{{ l.presentation.contract }}">{{ l.presentation.contract|slice(0,8) }}…{{ l.presentation.contract|slice(-6) }}</small>{% endif %}
</td>
<td>
	<a href="{{ _link('balance/admin/curr', false, 0) }}?id={{ l.cID }}">{{ l.cName }}</a>
    {% if l.currency_status == 'retired' %}<a class="mt-1 block text-sm" href="{{ _link('balance/admin/opers',false,0) }}?currency_id={{ l.cID }}">{{ _t({'key':'currency.operations','default':'Операции этой валюты'}) }}</a>{% endif %}
</td>
<td>
	{{ l.cCurr }}
</td>
<td>
{% if _cfg.Bal_Update %}
	{{ _z(l.cBal, l.cID) }}<br>
	<small>{{ timeToStr(stampToTime(l.cBalTS)) }}</small>
{% endif %}
</td>
<td>
	{% if l.PAPI.configured %}
		<a href="{{ _link('balance/admin/curr', false, 0) }}?id={{ l.cID }}&testapi">{{ _t({"key": 'currs.test', "default": 'тест'}) }}</a>
	{% endif %}
</td>
<td>
	{% if l.cDisabled %}<b style="color: red">X</b>{% endif %}
</td>
<td>
	{% if l.cCASHINMode > 0 %}*{% endif %}
</td>
<td>
	{% if l.cCASHOUTMode > 0 %}*{% endif %}
</td>
<td align="right">
	{% if l.cEXMode > 0 %}<small>{{ l.cEXOut }}/{{ l.cEXIn }}</small>{% endif %}
</td>
<td>
	{% if l.cTRMode > 0 %}*{% endif %}
</td>
<td>
	{% if l.cBUYMode > 0 %}*{% endif %}
</td>
<td>
	{% if l.cSELLMode > 0 %}*{% endif %}
</td>
<td>
	{% if l.cBUY2Mode > 0 %}*{% endif %}
</td>
<td>
	{% if l.cSELL2Mode > 0 %}*{% endif %}
</td>
<td>
	{% if l.cGIVEMode > 0 %}*{% endif %}
</td>
<td>
	{% if l.cTAKEMode > 0 %}*{% endif %}
</td>
<td>
	{% if l.cHidden %}{{ _t({"key": 'common.yes', "default": 'Да'}) }}{% endif %}
</td>
