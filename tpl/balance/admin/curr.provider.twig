{% set provider_fiat_names={'USD':(_t({'key':'gateway.admin.us_dollar'})),'EUR':(_t({'key':'gateway.admin.euro'})),'GBP':(_t({'key':'gateway.admin.pound_sterling'})),'CAD':(_t({'key':'gateway.admin.canadian_dollar'})),'AUD':(_t({'key':'gateway.admin.australian_dollar'})),'CHF':(_t({'key':'gateway.admin.swiss_franc'})),'JPY':(_t({'key':'gateway.admin.japanese_yen'})),'NZD':(_t({'key':'gateway.admin.new_zealand_dollar'})),'SGD':(_t({'key':'gateway.admin.singapore_dollar'})),'HKD':(_t({'key':'gateway.admin.hong_kong_dollar'})),'ILS':(_t({'key':'gateway.admin.israeli_shekel'})),'RON':(_t({'key':'gateway.admin.romanian_leu'})),'MXN':(_t({'key':'gateway.admin.mexican_peso'})),'PLN':(_t({'key':'gateway.admin.polish_zloty'})),'BRL':(_t({'key':'gateway.admin.brazilian_real'})),'THB':(_t({'key':'gateway.admin.thai_baht'}))} %}
<div class="hs-provider space-y-6">
    {% if provider_tab in ['settings','network','tokens'] %}<a class="inline-flex items-center gap-2 text-sm font-bold text-blue-600" href="{{ provider_connection_url }}">{{ _t({'key':'gateway.admin.connection'}) }} {{ provider_name }}</a>{% endif %}
    {% set provider_status_enabled = provider_tab == 'settings' ? (not provider_currency_values.cDisabled) : (provider_profile.ppState|default('') == 'enabled' and (provider_tab != 'network' or provider_is_token_page or provider_currency_values.cProviderSelected)) %}
    <div class="hs-provider-heading"><span class="hs-provider-icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></span><h2>{{ provider_name }}{% if provider_tab == 'settings' %} — {{ provider_currency_values.cCurrID }}{% elseif provider_tab == 'network' %} — {{ provider_network_label|default(provider_currency_values.cCurrID) }}{% endif %}</h2><span class="hs-provider-badge {{ provider_status_enabled ? 'is-enabled':'is-disabled' }}"><i class="fa-solid {{ provider_status_enabled ? 'fa-circle-check':'fa-circle-pause' }}" aria-hidden="true"></i>{% if (provider_tab == 'setup' or provider_is_token_page) %}{{ provider_profile.ppState|default('') == 'enabled' ? (_t({'key':'gateway.admin.gateway_enabled'})) : (_t({'key':'gateway.admin.gateway_disabled'})) }}{% elseif provider_tab == 'network' %}{{ provider_profile.ppState != 'enabled' ? (_t({'key':'gateway.admin.gateway_disabled'})) : (provider_currency_values.cProviderSelected ? (_t({'key':'gateway.admin.network_connected'})) : (_t({'key':'gateway.admin.network_disconnected'}))) }}{% else %}{{ provider_currency_values.cDisabled ? (_t({'key':'gateway.admin.currency_disabled'})):(_t({'key':'gateway.admin.currency_enabled'})) }}{% endif %}</span></div>
    {% if provider_tab == 'settings' or (provider_tab == 'network' and provider_kind == 'CCAPI') %}<nav class="flex flex-wrap gap-3" aria-label="{{ _t({'key':'gateway.admin.currency_settings'}) }}"><a class="rounded-xl border px-4 py-2 {% if provider_tab == 'settings' %}border-brand font-bold{% else %}border-gray-200 dark:border-gray-700{% endif %}" href="{{ provider_url }}&tab=settings">{{ _t({'key':'configurator.header.setup'}) }} {{ provider_currency_values.cCurrID }}</a>{% if provider_currency_network_url|default(false) %}<a class="rounded-xl border px-4 py-2 {% if provider_tab == 'network' %}border-brand font-bold{% else %}border-gray-200 dark:border-gray-700{% endif %}" href="{{ provider_currency_network_url }}">{{ _t({'key':'gateway.admin.network_wallets_and_tokens'}) }}</a>{% endif %}</nav>{% endif %}
    {% if provider_error %}<div role="alert" class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">{{ provider_error }}</div>{% endif %}
    {% if not provider_error or provider_choices|default(false) %}
    {% if provider_profile.ppState|default('') == 'retired' %}<p>{{ _t({'key':'gateway.admin.connection_removed_transaction_history_is_preserved'}) }}</p><a class="underline" href="{{ provider_connection_url }}">{{ _t({'key':'gateway.admin.current_connection'}) }}</a>
    {% elseif provider_tab == 'network' and provider_kind == 'CCAPI' %}
        {% if provider_network_label|default(false) %}{% include 'balance/admin/provider.tokens.twig' %}{% endif %}
    {% elseif provider_tab == 'settings' and provider_currency_values|default(false) %}
        <aside class="hs-provider-scope" aria-label="{{ _t({'key':'gateway.admin.currency_settings_scope'}) }}">
            <span class="hs-provider-scope-icon"><i class="fa-solid fa-sliders" aria-hidden="true"></i></span>
            <div class="min-w-0"><h3>{{ _t({'key':'configurator.header.setup'}) }} {{ provider_currency_values.cCurrID }}{% if provider_currency_presentation.network %} · {{ provider_currency_presentation.network }}{% endif %}</h3><p>{{ _t({'key':'gateway.admin.the_limits_fees_and_modes_on_this_page_apply'}) }} <a href="{{ provider_connection_url }}">{{ _t({'key':'gateway.admin.connection_page'}) }}</a>.</p>{% if provider_currency_presentation.contract %}<code class="hs-provider-scope-contract">{{ provider_currency_presentation.contract }}</code>{% endif %}</div>
            <span class="hs-provider-scope-state {{ provider_profile.ppState == 'enabled' ? '':'is-disabled' }}">{{ provider_profile.ppState == 'enabled' ? (_t({'key':'gateway.admin.gateway_enabled'})):(_t({'key':'gateway.admin.gateway_disabled'})) }}</span>
        </aside>
        <section class="card hs-curr-card">
            {% include 'balance/admin/curr.settings.twig' with {'currency_shared_provider':true,'form':'provider_currency_save','url':provider_url ~ '&tab=settings','values':provider_currency_values,'fields':{
                'cID':[], 'profile_id':[], 'revision':[], 'cDisabled':{0:'C',1:(_t({'key':'gateway.admin.disable_this_currency'}))},'cHidden':{0:'C',1:(_t({'key':'gateway.admin.hide_currency_from_users'}))},
                'cMTS':{0:'X',1:(_t({'key':'gateway.admin.updated'}))},99:(_t({'key':'gateway.admin.appearance'})),'cName':{0:'T',1:(_t({'key':'currs.name'}))},'cCurrID':{0:'X',1:(_t({'key':'gateway.admin.currency_code'}))},
                'cCurr':{0:'T',1:(_t({'key':'gateway.admin.currency_symbol'}))},'cNumDec':{0:'I',1:(_t({'key':'gateway.admin.decimal_places_0_6'})),min:0,max:6}
            }} %}
            {% if payment_route_choices|default(false) and not (provider_kind == 'CCAPI' and payment_route_choices|length == 1 and payment_route_enabled) %}
            <div class="border-t border-gray-100 p-6 dark:border-gray-800"><h3 class="text-lg font-bold">{{ _t({'key':'payment.routes.title'}) }}</h3>
                {% if payment_route_choices|length == 1 and payment_route_enabled %}{% for route in payment_route_choices %}<p class="mt-3 font-bold">{{ route.asset }} · {{ route.label }}</p>{% if route.contract %}<p class="mt-2 break-all font-mono text-sm text-gray-500">{{ route.contract }}</p>{% endif %}{% endfor %}
                {% else %}<p class="mt-2 text-sm text-gray-500">{{ _t({'key':'payment.routes.admin_hint'}) }}</p><form method="post" action="{{ provider_url }}&tab=settings" class="mt-5 space-y-4">{{ _getFormSecurity({'form':'provider_routes_save'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><div class="hs-provider-currencies">{% for code,route in payment_route_choices %}<label class="hs-provider-enabled"><input type="checkbox" name="payment_routes[]" value="{{ code }}" {% if code in payment_route_enabled %}checked{% endif %}><span><strong>{{ route.asset }}</strong> · {{ route.label }}{% if route.contract %}<small class="mt-1 block break-all font-mono">{{ route.contract }}</small>{% endif %}</span></label>{% endfor %}</div><button type="submit" name="provider_routes_save_btn" value="1" class="hs-provider-button">{{ _t({'key':'common.save'}) }}</button></form>{% endif %}
            </div>{% endif %}
        </section>
    {% else %}
        <p class="text-sm leading-relaxed text-gray-500">{{ _t({'key':'gateway.admin.shared_gateway_connection_and_credentials_limits_fees_and_availability'}) }}</p>
        {% if provider_tab == 'setup' and provider_kind in ['CCAPI','PAYKASSA','VOLET'] %}{% include 'balance/admin/provider.referral.twig' %}{% endif %}
        <section class="card hs-provider-panel"><form id="provider-connection-save" method="post" action="{{ provider_form_url }}" class="space-y-6">
            {{ _getFormSecurity({'form':'provider_save'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID|default(0) }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision|default(0) }}">

            {% if provider_is_token_page %}
                {% for key,field in provider_fields %}{% if not field[1] %}<input type="hidden" name="credentials[{{ key }}]" value="{{ provider_values[key]|default('') }}">{% endif %}{% endfor %}
                <input type="hidden" name="enabled" value="{{ provider_profile.ppState == 'enabled' ? '1':'0' }}">
            {% else %}
            <div class="hs-provider-section-title"><span>1</span><div><h3>{{ _t({'key':'gateway.admin.gateway_connection'}) }}</h3><p>{{ _t({'key':'gateway.admin.shared_credentials_and_access_to_all_gateway_currencies'}) }}</p></div></div>
            <div class="hs-provider-fields">{% for key,field in provider_fields %}<label class="block"><span class="mb-2 block text-sm font-bold">{{ _t({'key':field[0]}) }}</span><input class="hs-provider-input" name="credentials[{{ key }}]" type="{{ field[1] ? 'password':'text' }}" value="{{ field[1] ? '':provider_values[key]|default('') }}" autocomplete="{{ field[1] ? 'new-password':'off' }}" {% if field[1] %}placeholder="{{ provider_profile.ppID|default(false) ? (_t({'key':'gateway.admin.saved_leave_blank_to_keep_unchanged'})):(_t({'key':'gateway.admin.enter_key'})) }}"{% endif %}></label>{% endfor %}</div>
            <label class="hs-provider-enabled"><input type="hidden" name="enabled" value="0"><input type="checkbox" name="enabled" value="1" {% if not provider_profile or provider_profile.ppState == 'enabled' %}checked{% endif %}><span>{{ _t({'key':'gateway.admin.gateway_enabled'}) }}<small class="mt-1 block font-normal text-gray-500">{{ _t({'key':'gateway.admin.disabling_turns_off_currencies_and_their_deposit_and_withdrawal'}) }}</small></span></label>
            {% endif %}
            <div><div class="hs-provider-section-title"><span>2</span><div><h3>{{ provider_is_token_page ? ((_t({'key':'gateway.admin.tokens'}) ~ " ") ~ provider_network_label):(provider_kind in ['CCAPI','PAYKASSA'] ? (_t({'key':'gateway.admin.native_coins_and_networks'})):(_t({'key':'gateway.admin.currencies'}))) }}</h3><p>{{ _t({'key':'gateway.admin.selecting_enables_the_currency_deposit_and_withdrawal_modes_are'}) }}</p></div></div>{% for group,choices in provider_choice_groups %}{% if group %}<h4 class="mb-3 mt-5 font-bold">{{ group }}</h4>{% endif %}<div class="hs-provider-currencies">
            {% for asset,choice in choices %}{% if provider_kind != 'CCAPI' or asset not in ['USDT','USDC'] %}{% set currency_id=provider_bound_assets[asset]|default(0) %}{% set currency=provider_connections[currency_id]|default(null) %}
                <div class="hs-provider-currency-item flex h-full flex-col">
                    {% include 'balance/admin/currency.card.twig' with {'option_name':'currencies','option_value':asset,'option_code':choice.currency,'option_label':(provider_is_token_page and provider_kind == 'PAYKASSA' and asset == 'USDT') ? (provider_network_label ~ (" " ~ _t({'key':'gateway.admin.shared_account'}))):(provider_kind == 'PAYKASSA' ? choice.name|split(' · ')|last:provider_fiat_names[asset]|default(choice.name|split(' (')|first)),'option_selected':currency and currency.cProviderSelected,'option_network':provider_choice_networks[asset]|default(null),'option_connections':currency ? [currency]:[]} %}
                    {% if currency_id or not provider_bindings[asset]|default(false) %}<input type="hidden" name="bindings[{{ asset }}]" value="{{ currency_id }}">{% endif %}
                    {% if not currency_id and provider_bindings[asset]|default(false) %}<label class="mt-3 block text-sm">{{ _t({'key':'gateway.admin.existing_currency'}) }}<select name="bindings[{{ asset }}]" class="hs-provider-input mt-2"><option value="0">{{ _t({'key':'gateway.admin.select_a_currency_to_connect'}) }}</option>{% for binding in provider_bindings[asset] %}<option value="{{ binding.id }}">#{{ binding.id }} · {{ binding.name }}</option>{% endfor %}</select></label>{% endif %}
                    {% if provider_kind == 'VOLET' %}<label class="mt-3 block text-sm">{{ _t({'key':'gateway.admin.wallet'}) }} {{ asset }}<input class="hs-provider-input mt-2" name="wallets[{{ asset }}]" value="{{ provider_wallets[asset]|default('') }}" autocomplete="off"></label>{% endif %}
                </div>
            {% endif %}{% endfor %}</div>{% endfor %}</div>
            {% if provider_is_token_page %}<aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.paykassa_creates_a_payment_address_for_each_invoice_merchant'}) }}{% if provider_pay_network in ['shared','ethereum','tron'] %} {{ _t({'key':'gateway.admin.usdt_uses_one_shared_balance_for_ethereum_and_tron'}) }}{% endif %}</p></aside>{% if not provider_choice_groups %}<p class="text-sm text-gray-500">{{ _t({'key':'gateway.admin.this_network_has_no_additional_tokens'}) }}</p>{% endif %}{% endif %}
            {% for asset,choice in provider_hidden_choices %}{% set cid=provider_bound_assets[asset]|default(0) %}{% if cid and provider_connections[cid].cProviderSelected %}<input type="hidden" name="currencies[]" value="{{ asset }}">{% endif %}<input type="hidden" name="bindings[{{ asset }}]" value="{{ cid }}">{% endfor %}
            <aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.deselecting_archives_the_currency_while_preserving_its_balance_and'}) }}</p></aside>
            {% if provider_kind == 'CCAPI' %}<aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.the_collection_wallet_payout_source_and_token_catalog_are'}) }}</p></aside>{% endif %}
            {% if provider_kind == 'STRIPE' %}<div class="hs-provider-note">{{ _t({'key':'gateway.admin.payments_use_stripe_checkout_crediting_uses_a_signed_webhook'}) }}{% if provider_webhook|default(false) %}<p class="mt-2 font-bold">Webhook endpoint</p><code class="block break-all">{{ provider_webhook }}</code>{% endif %}<p class="mt-2">{{ _t({'key':'gateway.admin.events_checkout_session_completed_checkout_session_async_payment_succeeded'}) }}</p><a class="underline" href="https://docs.stripe.com/payments/checkout" target="_blank" rel="noopener noreferrer">{{ _t({'key':'gateway.admin.stripe_checkout_documentation'}) }}</a></div>{% endif %}
            {% if provider_kind == 'PAYKASSA' and provider_tab == 'setup' %}<aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><div><p>{{ _t({'key':'gateway.admin.saving_requests_the_merchant_balance_to_verify_the_api'}) }}</p><p class="mt-2">{{ _t({'key':'gateway.admin.merchant_id_and_sci_password_are_used_to_create'}) }}</p></div></aside>{% elseif provider_kind == 'VOLET' %}<aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.saving_checks_api_access_and_ownership_of_the_selected'}) }}</p></aside>{% endif %}
            <input type="hidden" name="form_complete" value="1">
        </form>
        <div class="hs-provider-actions">
            <button type="submit" form="provider-connection-save" name="provider_save_btn" value="1" class="hs-provider-button">{{ _t({'key':'gateway.admin.verify_connection_and_save'}) }}</button>
            {% if provider_tab == 'setup' and provider_profile.ppID|default(false) %}<form method="post" action="{{ provider_connection_url }}">{{ _getFormSecurity({'form':'provider_manage'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><button type="submit" class="hs-provider-button hs-provider-button--remove" name="provider_manage_btnremove" value="1">{{ _t({'key':'gateway.admin.archive_gateway_and_all_its_currencies'}) }}</button></form>{% endif %}
        </div></section>
    {% endif %}{% endif %}
</div>
