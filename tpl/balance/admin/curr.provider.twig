{% set provider_fiat_names={'USD':'Доллар США','EUR':'Евро','GBP':'Фунт стерлингов','CAD':'Канадский доллар','AUD':'Австралийский доллар','CHF':'Швейцарский франк','JPY':'Японская иена','NZD':'Новозеландский доллар','SGD':'Сингапурский доллар','HKD':'Гонконгский доллар','ILS':'Израильский шекель','RON':'Румынский лей','MXN':'Мексиканское песо','PLN':'Польский злотый','BRL':'Бразильский реал','THB':'Таиландский бат'} %}
<div class="hs-provider space-y-6">
    {% if provider_tab != 'setup' %}<a class="inline-flex items-center gap-2 text-sm font-bold text-blue-600" href="{{ provider_connection_url }}">← Подключение {{ provider_name }}</a>{% endif %}
    {% set provider_status_enabled = provider_tab == 'settings' ? (not provider_currency_values.cDisabled) : (provider_profile.ppState|default('') == 'enabled' and (provider_tab != 'network' or provider_currency_values.cProviderSelected)) %}
    <div class="hs-provider-heading"><span class="hs-provider-icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></span><h2>{{ provider_name }}{% if provider_tab == 'settings' %} — {{ provider_currency_values.cCurrID }}{% elseif provider_tab == 'network' %} — {{ provider_network_label|default(provider_currency_values.cCurrID) }}{% endif %}</h2><span class="hs-provider-badge {{ provider_status_enabled ? 'is-enabled':'is-disabled' }}"><i class="fa-solid {{ provider_status_enabled ? 'fa-circle-check':'fa-circle-pause' }}" aria-hidden="true"></i>{% if provider_tab == 'setup' %}{{ provider_profile.ppState|default('') == 'enabled' ? 'Шлюз включён' : 'Шлюз выключен' }}{% elseif provider_tab == 'network' %}{{ provider_profile.ppState != 'enabled' ? 'Шлюз выключен' : (provider_currency_values.cProviderSelected ? 'Сеть подключена' : 'Сеть не подключена') }}{% else %}{{ provider_currency_values.cDisabled ? 'Валюта выключена':'Валюта включена' }}{% endif %}</span></div>
    {% if provider_tab != 'setup' %}<nav class="flex flex-wrap gap-3" aria-label="Настройки валюты"><a class="rounded-xl border px-4 py-2 {% if provider_tab == 'settings' %}border-brand font-bold{% else %}border-gray-200 dark:border-gray-700{% endif %}" href="{{ provider_url }}&tab=settings">Настройки {{ provider_currency_values.cCurrID }}</a>{% if provider_currency_network_url|default(false) %}<a class="rounded-xl border px-4 py-2 {% if provider_tab == 'network' %}border-brand font-bold{% else %}border-gray-200 dark:border-gray-700{% endif %}" href="{{ provider_currency_network_url }}">Кошельки и токены сети</a>{% endif %}</nav>{% endif %}
    {% if provider_error %}<div role="alert" class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">{{ provider_error }}</div>{% endif %}
    {% if not provider_error or provider_choices|default(false) %}
    {% if provider_profile.ppState|default('') == 'retired' %}<p>Подключение удалено. История операций сохранена.</p><a class="underline" href="{{ provider_connection_url }}">Текущее подключение</a>
    {% elseif provider_tab == 'network' %}
        {% if provider_network_label|default(false) %}{% include 'balance/admin/provider.tokens.twig' %}{% endif %}
    {% elseif provider_tab == 'settings' and provider_currency_values|default(false) %}
        <aside class="hs-provider-scope" aria-label="Область настроек валюты">
            <span class="hs-provider-scope-icon"><i class="fa-solid fa-sliders" aria-hidden="true"></i></span>
            <div class="min-w-0"><h3>Настройки {{ provider_currency_values.cCurrID }}{% if provider_currency_presentation.network %} · {{ provider_currency_presentation.network }}{% endif %}</h3><p>Лимиты, комиссии и режимы на этой странице относятся только к этой валюте. Общий ключ API и включение шлюза находятся на <a href="{{ provider_connection_url }}">странице подключения</a>.</p>{% if provider_currency_presentation.contract %}<code class="hs-provider-scope-contract">{{ provider_currency_presentation.contract }}</code>{% endif %}</div>
            <span class="hs-provider-scope-state {{ provider_profile.ppState == 'enabled' ? '':'is-disabled' }}">{{ provider_profile.ppState == 'enabled' ? 'Шлюз включён':'Шлюз выключен' }}</span>
        </aside>
        <section class="card hs-curr-card">
            {% include 'balance/admin/curr.settings.twig' with {'currency_shared_provider':true,'form':'provider_currency_save','url':provider_url ~ '&tab=settings','values':provider_currency_values,'fields':{
                'cID':[], 'profile_id':[], 'revision':[], 'cDisabled':{0:'C',1:'Отключить эту валюту'},'cHidden':{0:'C',1:'Скрыть валюту от пользователей'},
                'cMTS':{0:'X',1:'Исправлено'},99:'Вид','cName':{0:'T',1:'Наименование'},'cCurrID':{0:'X',1:'Код валюты'},
                'cCurr':{0:'T',1:'Обозначение валюты'},'cNumDec':{0:'I',1:'Знаков после запятой (0–6)',min:0,max:6}
            }} %}
            {% if payment_route_choices|default(false) and not (provider_kind == 'CCAPI' and payment_route_choices|length == 1 and payment_route_enabled) %}
            <div class="border-t border-gray-100 p-6 dark:border-gray-800"><h3 class="text-lg font-bold">{{ _t({'key':'payment.routes.title'}) }}</h3>
                {% if payment_route_choices|length == 1 and payment_route_enabled %}{% for route in payment_route_choices %}<p class="mt-3 font-bold">{{ route.asset }} · {{ route.label }}</p>{% if route.contract %}<p class="mt-2 break-all font-mono text-sm text-gray-500">{{ route.contract }}</p>{% endif %}{% endfor %}
                {% else %}<p class="mt-2 text-sm text-gray-500">{{ _t({'key':'payment.routes.admin_hint'}) }}</p><form method="post" action="{{ provider_url }}&tab=settings" class="mt-5 space-y-4">{{ _getFormSecurity({'form':'provider_routes_save'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><div class="hs-provider-currencies">{% for code,route in payment_route_choices %}<label class="hs-provider-enabled"><input type="checkbox" name="payment_routes[]" value="{{ code }}" {% if code in payment_route_enabled %}checked{% endif %}><span><strong>{{ route.asset }}</strong> · {{ route.label }}{% if route.contract %}<small class="mt-1 block break-all font-mono">{{ route.contract }}</small>{% endif %}</span></label>{% endfor %}</div><button type="submit" name="provider_routes_save_btn" value="1" class="hs-provider-button">{{ _t({'key':'common.save'}) }}</button></form>{% endif %}
            </div>{% endif %}
        </section>
    {% else %}
        <p class="text-sm leading-relaxed text-gray-500">Один ключ API для подключения шлюза. Лимиты, комиссии и доступность каждой валюты настраиваются отдельно.</p>
        {% if provider_kind == 'CCAPI' %}{% include 'balance/admin/provider.referral.twig' %}{% endif %}
        <section class="card hs-provider-panel"><form id="provider-connection-save" method="post" action="{{ provider_connection_url }}" class="space-y-6">
            {{ _getFormSecurity({'form':'provider_save'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID|default(0) }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision|default(0) }}">
            {% if provider_kind == 'CCAPI' %}{% for currency in provider_connections %}{% if currency.cCID in ['CCTU','CCTC'] and currency.cProviderSelected %}<input type="hidden" name="currencies[]" value="{{ currency.cCurrID }}">{% endif %}{% endfor %}{% endif %}
            <div class="hs-provider-section-title"><span>1</span><div><h3>Подключение шлюза</h3><p>Общие ключи и доступ ко всем его валютам.</p></div></div>
            <div class="hs-provider-fields">{% for key,field in provider_fields %}<label class="block"><span class="mb-2 block text-sm font-bold">{{ field[0] }}</span><input class="hs-provider-input" name="credentials[{{ key }}]" type="{{ field[1] ? 'password':'text' }}" value="{{ field[1] ? '':provider_values[key]|default('') }}" autocomplete="{{ field[1] ? 'new-password':'off' }}" {% if field[1] %}placeholder="{{ provider_profile.ppID|default(false) ? 'Сохранён; оставьте пустым без изменений':'Введите ключ' }}"{% endif %}></label>{% endfor %}</div>
            <label class="hs-provider-enabled"><input type="hidden" name="enabled" value="0"><input type="checkbox" name="enabled" value="1" {% if not provider_profile or provider_profile.ppState == 'enabled' %}checked{% endif %}><span>Шлюз включён<small class="mt-1 block font-normal text-gray-500">Выключение отключает валюты и режимы приёма и вывода. Комиссии, лимиты и история сохраняются; включать валюты затем нужно в их настройках.</small></span></label>
            <div><div class="hs-provider-section-title"><span>2</span><div><h3>{{ provider_kind == 'CCAPI' ? 'Основные монеты и сети':'Валюты' }}</h3><p>Добавление валюты не включает приём платежей. Откройте её настройки, чтобы задать режимы и комиссии.</p></div></div><div class="hs-provider-currencies">
            {% for asset,choice in provider_choices %}{% if provider_kind != 'CCAPI' or asset not in ['USDT','USDC'] %}{% set currency_id=provider_bound_assets[asset]|default(0) %}{% set currency=provider_connections[currency_id]|default(null) %}
                <div class="hs-provider-currency">
                    {% if currency and currency.cProviderSelected %}<input type="hidden" name="currencies[]" value="{{ asset }}"><div class="flex items-center justify-between gap-3 font-bold">{{ asset }}<small class="text-xs font-normal text-gray-500">Подключена</small></div>
                    {% else %}<label class="flex items-center gap-3 font-bold"><input type="checkbox" name="currencies[]" value="{{ asset }}">{{ asset }}<span class="text-sm font-normal text-gray-500">{{ provider_fiat_names[asset]|default(choice.name|split(' (')|first) }}</span></label>{% endif %}
                    {% if currency_id %}<input type="hidden" name="bindings[{{ asset }}]" value="{{ currency_id }}">
                        <div class="hs-provider-currency-actions">
                            <a href="{{ _link('balance/admin/curr',false,0) }}?id={{ currency_id }}" aria-labelledby="provider-currency-title-{{ currency_id }}" aria-describedby="provider-currency-hint-{{ currency_id }}"><i class="fa-solid fa-sliders" aria-hidden="true"></i><span><strong id="provider-currency-title-{{ currency_id }}">Настроить {{ asset }}</strong><small id="provider-currency-hint-{{ currency_id }}">Лимиты, комиссии и доступность</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
                            {% if currency.network_url|default(false) %}<a class="is-network" href="{{ _link('balance/admin/curr',false,0) }}?id={{ currency_id }}&tab=network" aria-labelledby="provider-network-title-{{ currency_id }}" aria-describedby="provider-network-hint-{{ currency_id }}"><i class="fa-solid fa-wallet" aria-hidden="true"></i><span><strong id="provider-network-title-{{ currency_id }}">Кошельки и токены</strong><small id="provider-network-hint-{{ currency_id }}">Адрес сбора и источник выплат</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>{% endif %}
                        </div>
                    {% elseif provider_bindings[asset]|default(false) %}<label class="mt-3 block text-sm">Существующая валюта<select name="bindings[{{ asset }}]" class="hs-provider-input mt-2"><option value="0">— выберите валюту для подключения —</option>{% for binding in provider_bindings[asset] %}<option value="{{ binding.id }}">#{{ binding.id }} · {{ binding.name }}</option>{% endfor %}</select></label><p class="mt-2 text-xs text-gray-500">Её ID, балансы и история сохранятся.</p>
                    {% else %}<input type="hidden" name="bindings[{{ asset }}]" value="0">{% endif %}
                    {% if provider_kind == 'VOLET' %}<label class="mt-3 block text-sm">Кошелёк {{ asset }}<input class="hs-provider-input mt-2" name="wallets[{{ asset }}]" value="{{ provider_wallets[asset]|default('') }}" autocomplete="off"></label>{% endif %}
                </div>
            {% endif %}{% endfor %}</div></div>
            {% if provider_kind == 'CCAPI' %}<p class="hs-provider-note">Кошелёк сбора, источник ручных выплат и каталог токенов доступны на странице нужной сети по ссылке «Кошельки и токены». Адрес для оплаты каждого счёта создаётся отдельно. Для XRP нужен отдельный адрес без destination tag.</p>{% endif %}
            {% if provider_kind == 'STRIPE' %}<div class="hs-provider-note">Оплата проходит через Stripe Checkout, зачисление — по подписанному webhook. Автоматический вывод не подключён.{% if provider_webhook|default(false) %}<p class="mt-2 font-bold">Webhook endpoint</p><code class="block break-all">{{ provider_webhook }}</code>{% endif %}<p class="mt-2">События: checkout.session.completed, checkout.session.async_payment_succeeded. Версия API: 2026-09-30.endive.</p><a class="underline" href="https://docs.stripe.com/payments/checkout" target="_blank" rel="noopener noreferrer">Документация Stripe Checkout</a></div>{% endif %}
            {% if provider_kind in ['PAYKASSA','VOLET'] %}<p class="hs-provider-note">Проверяется доступ к API. Настройки приёма платежей проверяются при создании и обработке счёта.</p>{% endif %}
        </form>
        <div class="hs-provider-actions">
            <button type="submit" form="provider-connection-save" name="provider_save_btn" value="1" class="hs-provider-button">Проверить подключение и сохранить</button>
            {% if provider_profile.ppID|default(false) %}<form method="post" action="{{ provider_connection_url }}">{{ _getFormSecurity({'form':'provider_manage'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><button type="submit" class="hs-provider-button hs-provider-button--remove" name="provider_manage_btnremove" value="1">Удалить подключение, сохранив историю</button></form>{% endif %}
        </div></section>
    {% endif %}{% endif %}
</div>
