<div class="hs-provider space-y-6">
    <div class="hs-provider-heading"><span class="hs-provider-icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></span><h2>{{ legacy_setup.name }}</h2><span class="hs-provider-badge is-disabled"><i class="fa-solid fa-sliders" aria-hidden="true"></i>{{ _t({'key':'gateway.admin.currency_setup'}) }}</span></div>
    <p class="hs-provider-intro">{{ _t({'key':'gateway.admin.select_gateway_currencies_payment_details_availability_limits_and_fees'}) }}</p>
    {% if legacy_setup_error|default(false) %}<p role="alert" class="hs-provider-note text-red-700">{{ legacy_setup_error }}</p>{% endif %}
    {% if legacy_setup.kind in ['BANKWIRE','SBERBANK'] %}
    <aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-building-columns" aria-hidden="true"></i><div><strong>{{ _t({'key':'gateway.admin.bank_transfers_with_manual_verification'}) }}</strong><p class="mt-2">{{ _t({'key':'gateway.admin.each_currency_has_separate_beneficiary_details_an_administrator_confirms'}) }}</p>{% if legacy_setup.kind == 'BANKWIRE' %}<p class="mt-2">{{ _t({'key':'gateway.admin.international_transfers_use_an_iban_or_account_number_swift'}) }}</p>{% else %}<p class="mt-2">{{ _t({'key':'gateway.admin.this_is_a_bank_transfer_using_account_details_sberpay'}) }}</p>{% endif %}</div></aside>
    {% else %}<aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><div>{{ _t({'key':'gateway.admin.configure_the_recipient_and_signed_notifications_on_the_currency'}) }} {{ legacy_setup.kind == 'WEBMONEY' ? (_t({'key':'gateway.admin.the_current_adapter_supports_usd_wmz'})):(_t({'key':'gateway.admin.the_yoomoney_wallet_and_bank_card_are_separate_rub'})) }}</div></aside>{% endif %}
    {% if legacy_setup.kind in ['WEBMONEY','YOOMONEY'] %}<section class="card hs-provider-panel">
        <div class="hs-provider-section-title"><span>1</span><div><h3>{{ _t({'key':'gateway.admin.account_settings'}) }}</h3><p>{{ legacy_setup.kind == 'WEBMONEY' ? (_t({'key':'gateway.admin.wmid_identifies_the_webmoney_account_set_the_wmz_wallet'})):(_t({'key':'gateway.admin.yoomoney_application_settings_and_wallet_api_access_token_set'})) }}</p></div></div>
        {% for account in legacy_accounts %}<form name="legacy_account_save" method="post" action="{{ legacy_setup.url }}" class="space-y-5" data-legacy-account="{{ account.id }}">
            {{ _getFormSecurity({'form':'legacy_account_save'}) }}
            <input type="hidden" name="currency_id" value="{{ account.id }}"><input type="hidden" name="revision" value="{{ account.revision }}">
            {% if legacy_accounts|length > 1 %}<p class="text-sm font-semibold text-gray-500">{{ _t({'key':'gateway.admin.connection_account'}) }}{{ account.id }}</p>{% endif %}
            <div class="hs-provider-fields">{% for key,field in account.fields %}<label class="block"><span class="mb-2 block text-sm font-bold">{{ _t({'key':field.label}) }}</span><input class="hs-provider-input" type="{{ field.secret ? 'password':'text' }}" name="account_fields[{{ key }}]" value="{{ field.value }}" maxlength="2048" autocomplete="{{ field.secret ? 'new-password':'off' }}" spellcheck="false"{% if field.secret %} placeholder="{{ field.saved ? (_t({'key':'gateway.admin.saved_leave_blank_to_keep_unchanged'})):(_t({'key':'gateway.admin.enter_value'})) }}"{% endif %}></label>{% endfor %}</div>
            <input type="hidden" name="form_complete" value="1"><button class="hs-provider-button" type="submit" name="legacy_account_save_btn" value="1">{{ _t({'key':'gateway.admin.save_account_settings'}) }}</button>
        </form>{% else %}<aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.add'}) }} {{ legacy_setup.kind == 'WEBMONEY' ? 'USD / WMZ':(_t({'key':'gateway.admin.rub_via_wallet'})) }} {{ _t({'key':'gateway.admin.below_to_configure_the_account'}) }}</p></aside>{% endfor %}
        {% if legacy_accounts %}<aside class="hs-provider-note hs-provider-network-note mt-5"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.this_saves_connection_settings_saving_makes_no_payment_system'}) }}</p></aside>{% endif %}
    </section>{% endif %}
    {% if legacy_setup.choices %}<section class="card hs-provider-panel">
        <form name="legacy_add" method="post" action="{{ legacy_setup.url }}" class="space-y-6">
            {{ _getFormSecurity({'form':'legacy_add'}) }}<input type="hidden" name="revision" value="{{ legacy_selection_revision }}">
            <div class="hs-provider-section-title"><span>{{ legacy_setup.kind in ['YOOMONEY','WEBMONEY'] ? '2':'1' }}</span><div><h3>{{ _t({'key':'gateway.admin.accounting_currencies'}) }}</h3><p>{{ _t({'key':'gateway.admin.each_currency_has_its_own_balance_bank_details_limits'}) }}</p></div></div>
            {% set fiat_names={'USD':(_t({'key':'gateway.admin.us_dollar'})),'EUR':(_t({'key':'gateway.admin.euro'})),'GBP':(_t({'key':'gateway.admin.pound_sterling'})),'CHF':(_t({'key':'gateway.admin.swiss_franc'})),'RUB':(_t({'key':'gateway.admin.russian_ruble'})),'CAD':(_t({'key':'gateway.admin.canadian_dollar'})),'AUD':(_t({'key':'gateway.admin.australian_dollar'})),'NZD':(_t({'key':'gateway.admin.new_zealand_dollar'})),'SGD':(_t({'key':'gateway.admin.singapore_dollar'})),'HKD':(_t({'key':'gateway.admin.hong_kong_dollar'})),'CNY':(_t({'key':'gateway.admin.chinese_yuan'})),'PLN':(_t({'key':'gateway.admin.polish_zloty'})),'CZK':(_t({'key':'gateway.admin.czech_koruna'})),'NOK':(_t({'key':'gateway.admin.norwegian_krone'})),'SEK':(_t({'key':'gateway.admin.swedish_krona'})),'DKK':(_t({'key':'gateway.admin.danish_krone'})),'RON':(_t({'key':'gateway.admin.romanian_leu'})),'TRY':(_t({'key':'gateway.admin.turkish_lira'})),'KZT':(_t({'key':'gateway.admin.kazakhstani_tenge'})),'AED':(_t({'key':'gateway.admin.uae_dirham'})),'INR':(_t({'key':'gateway.admin.indian_rupee'})),'BRL':(_t({'key':'gateway.admin.brazilian_real'})),'MXN':(_t({'key':'gateway.admin.mexican_peso'})),'ZAR':(_t({'key':'gateway.admin.south_african_rand'}))} %}
            <div class="hs-provider-currencies">{% for code,choice in legacy_setup.choices %}
                {% set label=legacy_setup.kind == 'YOOMONEY' ? (code == 'YM' ? (_t({'key':'gateway.admin.russian_ruble_wallet'})):(_t({'key':'gateway.admin.russian_ruble_bank_card'}))) : (legacy_setup.kind == 'WEBMONEY' ? (_t({'key':'gateway.admin.us_dollar_wmz'})):fiat_names[choice.currency]|default(choice.label)) %}
                {% include 'balance/admin/currency.card.twig' with {'option_name':'assets','option_value':code,'option_code':choice.currency,'option_label':label,'option_selected':choice.exists,'option_connections':choice.connections,'option_hint':(_t({'key':'gateway.admin.payment_details_limits_and_fees'})),'option_activation_disabled':choice.connections|length > 1} %}
            {% endfor %}</div>
            <aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.select_the_required_currencies_and_save_deselecting_archives_a'}) }}</p></aside>
            <input type="hidden" name="form_complete" value="1"><button class="hs-provider-button" type="submit" name="legacy_add_btn" value="1">{{ _t({'key':'gateway.admin.save_currencies'}) }}</button>
        </form>
    </section>{% endif %}

</div>
