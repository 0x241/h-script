
{% set balance_setup_title = _t({"key": 'balance.setup.title', "default": 'Настройки'}) %}
{% include "admin/header.twig" with {"title": balance_setup_title} %}

{% if curr1 %}
	<p class="info">
		{% if _cfg.Const_IntCurr %}
			{{ _t({"key": 'balance.setup.info_int', "curr": curr1.cCurrID, "default": 'Скрипт работает в режиме "Единая внутренняя валюта".'}) }}
		{% else %}
			{{ _t({"key": 'balance.setup.info_single', "default": 'Настроена всего одна платежная система и скрипт принимает ее за единственную'}) }}
		{% endif %}
	</p>
{% endif %}

