
{% include "admin/header.twig" with {"title": 'Платежная система'} %}

{% if el %}

	<h2>{% if el.cCID == '*' %}Внутренняя платежная система{% else %}Платежная система [{{ el.cCID }}]{% endif %}</h2>

	{% if isset(_GET.testapi) %}

		<h2>Тест API</h2>
		<p class="info">
			{% if res.result == 'OK' %}
				Баланс кошелька: <b>{{ _z(res.sum, el.cID, -1) }}</b> {{ el.cCurr }}.<br>
				Тест успешно пройден!
			{% else %}
				Ошибка <b>{{ res.result }}</b>
			{% endif %}
		</p>
		
	{% endif %}

	{% if sfields %}
		{% set sfields = merge_arrays({1: 'SCI <small>(пополнение)</small>'}, sfields) %}
	{% endif %}
	{% if afields %}
		{% set afields = merge_arrays({2: 'API <small>(вывод)</small>'}, afields) %}
	{% endif %}
	{% set params = {77: 'Живой баланс', 'cBal': ['X', 'Последнее значение'], 'cBalMin': ['$', 'Оповещать, если баланс ниже Х'], 5: 'Пополнение', 'cCASHINMode': ['S', 'Режим', 0, {0: 'отключено', 1: 'ручной', 2: 'через мерчант', 3: 'ручной и через мерчант'}], 'cCASHINMin': ['$', 'Мин. сумма'], 'cCASHINMax': ['$', 'Макс. сумма <<0 - по умолчанию>>'], 'cCASHINInt': {0: 'C', 1: 'Только целыми суммами', 'default': 0}, 'cCASHINComis': ['%', 'Процент комиссии'], 'cCASHINComisMin': ['$', 'Мин. сумма комиссии'], 'cCASHINComisMax': ['$', 'Макс. сумма комиссии <<0 - нет>>'], 6: 'Вывод', 'cCASHOUTMode': ['S', 'Режим', 0, {0: 'отключен', 1: 'ручной', 2: 'мгновенно'}], 'cCASHOUTMin': ['$', 'Мин. сумма'], 'cCASHOUTMax': ['$', 'Макс. сумма <<0 - по умолчанию>>'], 'cCASHOUTInt': {0: 'C', 1: 'Только целыми суммами', 'default': 0}, 'cCASHOUTComis': ['%', 'Процент комиссии'], 'cCASHOUTComisMin': ['$', 'Мин. сумма комиссии'], 'cCASHOUTComisMax': ['$', 'Макс. сумма комиссии <<0 - нет>>'], 'cCASHOUTLimitPer': ['I', 'Период лимита <<в часах, 0 - нет>>'], 'cCASHOUTLimit': ['$', 'Сумма лимита'], 7: 'Обмен', 'cEXMode': ['S', 'Режим', 0, {0: 'отключен', 1: 'ручной', 2: 'мгновенно'}], 'cEXOut': ['%', 'Корр. <<в процентах к курсу>> при обмене НА внут. валюту'], 'cEXIn': ['%', 'Корр. <<в процентах к курсу>> при обмене С внут. валюты'], 'cEXMin': ['$', 'Мин. сумма'], 'cEXMax': ['$', 'Макс. сумма <<0 - по умолчанию>>'], 'cEXInt': {0: 'C', 1: 'Только целыми суммами', 'default': 0}, 'cEXComis': ['%', 'Процент комиссии'], 'cEXComisMin': ['$', 'Мин. сумма комиссии'], 'cEXComisMax': ['$', 'Макс. сумма комиссии <<0 - нет>>'], 8: 'Перевод', 'cTRMode': ['S', 'Режим', 0, {0: 'отключен', 1: 'ручной', 2: 'мгновенно'}], 'cTRMin': ['$', 'Мин. сумма'], 'cTRMax': ['$', 'Макс. сумма <<0 - по умолчанию>>'], 'cTRInt': {0: 'C', 1: 'Только целыми суммами', 'default': 0}, 'cTRComis': ['%', 'Процент комиссии'], 'cTRComisMin': ['$', 'Мин. сумма комиссии'], 'cTRComisMax': ['$', 'Макс. сумма комиссии <<0 - нет>>'], 0: 'Покупка', 'cBUYMode': ['S', 'Режим', 0, {0: 'отключена', 1: 'ручной', 2: 'мгновенно'}], 1: 'Продажа', 'cSELLMode': ['S', 'Режим', 0, {0: 'отключена', 1: 'ручной', 2: 'мгновенно'}], 2: 'Услуга', 'cBUY2Mode': ['S', 'Режим', 0, {0: 'отключена', 1: 'ручной', 2: 'мгновенно'}], 3: 'Оказание услуги', 'cSELL2Mode': ['S', 'Режим', 0, {0: 'отключено', 1: 'ручной', 2: 'мгновенно'}], 4: 'Вклад', 'cGIVEMode': ['S', 'Режим', 0, {0: 'отключен', 1: 'ручной', 2: 'мгновенно'}], 5: 'Снятие', 'cTAKEMode': ['S', 'Режим', 0, {0: 'отключено', 1: 'ручной', 2: 'мгновенно'}]} %}
	<div class="card hs-curr-card">
	{% include "edit.twig" with {"fields": merge_arrays(merge_arrays(merge_arrays(merge_arrays({'cID': [], 'cCID': [], 'cDisabled': {0: 'C', 1: 'Отключена', 'default': 1}, 'cHidden': {0: 'C', 1: 'Скрыта', 'default': 1}, 'cMTS': {0: 'X', 1: 'Исправлено', 'skip': not el.cMTS}, 99: 'Вид', 'cName': {0: 'T', 1: 'Наименование', 'size': 30, 'comment': cName}, 'cCurr': {0: 'T', 1: 'Валюта', 'comment': el.cCurrID}, 'cNumDec': ['I', 'Кол-во знаков после запятой (0-6) <<0 - по умолчанию>>']}, pfields), sfields), afields), params), "values": el} %}
	</div>
	
{% else %}

	<div class="card hs-curr-card">
	{% include "edit.twig" with {"form": 'add', "title": 'Новая платежная система', "fields": {'PSys': ['S', '', {'psys_not_selected': 'выберите плат.систему'}, merge_arrays({0: '- выберите -'}, cids)]}, "btn_text": 'Добавить'} %}
	</div>
	
{% endif %}

{% include "admin/footer.twig" %}
