
{% include "admin/header.twig" with {"title": 'Платежная система'} %}

{% if retired_currency|default(false) %}
    <h2>Платёжный провайдер удалён</h2><p class="info">Это архивная валюта. Балансы и история операций сохранены; подключение и изменение настроек недоступны.</p>
{% elseif provider_mode|default(false) %}
    {% include 'balance/admin/curr.provider.twig' %}
{% elseif paw_mode|default(false) %}

	{% include 'balance/admin/curr.paw.twig' %}

{% elseif el %}

	<h2>{% if el.cCID == '*' %}Внутренняя платежная система{% else %}Платежная система [{{ el.cCID }}]{% endif %}</h2>

    {% if legacy_provider_kind|default(false) %}<p class="info">Для {{ cName }} доступно общее подключение. <a href="{{ _link('balance/admin/curr',false,0) }}?provider={{ legacy_provider_kind }}" class="underline">Подключение и валюты</a></p>{% endif %}
	{% if isset(_GET.testapi) %}

		<h2>Тест API</h2>
		<p class="info">
			{% if res.result == 'OK' %}
				Баланс кошелька: <b>{{ _z(res.sum, el.cID, -1) }}</b> {{ el.cCurr }}.<br>
				Тест успешно пройден!
			{% else %}
				Ошибка <b>{{ res.result }}</b>
			{% endif %}
		</p>
		
	{% endif %}

	{% if sfields %}
		{% set sfields = merge_arrays({1: 'SCI <small>(пополнение)</small>'}, sfields) %}
	{% endif %}
	{% if afields %}
		{% set afields = merge_arrays({2: 'API <small>(вывод)</small>'}, afields) %}
	{% endif %}

	<div class="card hs-curr-card">
	{% include "balance/admin/curr.settings.twig" with {"fields": merge_arrays(merge_arrays(merge_arrays({'cID': [], 'cCID': [], 'cDisabled': {0: 'C', 1: 'Отключена', 'default': 1}, 'cHidden': {0: 'C', 1: 'Скрыта', 'default': 1}, 'cMTS': {0: 'X', 1: 'Исправлено', 'skip': not el.cMTS}, 99: 'Вид', 'cName': {0: 'T', 1: 'Наименование', 'size': 30, 'comment': cName}, 'cCurr': {0: 'T', 1: 'Валюта', 'comment': el.cCurrID}, 'cNumDec': ['I', 'Кол-во знаков после запятой (0-6) <<0 - по умолчанию>>']}, pfields), sfields), afields), "values": el, "errors": {"currency_decimal_invalid": "Проверьте суммы, комиссии и корректировки: недопустимая точность или слишком большое значение."}} %}
	</div>
	
{% else %}

	<div class="card hs-curr-card">
    {% if add_provider_kind|default(false) %}
        {% include 'edit.twig' with {'form':'add','title':add_provider_name,'values':{'PSys':add_provider_kind},'fields':{'PSys':[],'Gateway':['S','Валюта',{'psys_not_selected':'Выберите валюту','psys_already_exists':'Эта валюта уже подключена'},add_variants]},'btn_text':'Добавить валюту'} %}
    {% else %}
	{% include "edit.twig" with {"form": 'add' , "title": 'Новая платежная система', "fields": {'PSys': ['S', '', {'psys_not_selected': 'выберите плат.систему'}, merge_arrays({0: '- выберите -'}, cids)]}, "btn_text": 'Добавить'} %}
    {% endif %}
	</div>
	
{% endif %}

{% include "admin/footer.twig" %}
