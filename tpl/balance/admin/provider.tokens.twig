{% if provider_network_selected %}<section class="card hs-provider-panel">
    <div class="hs-provider-section-title"><span><i class="fa-solid fa-wallet" aria-hidden="true"></i></span><div><h3>{{ _t({'key':'gateway.admin.wallets'}) }} {{ provider_network_label }}</h3><p>{{ _t({'key':'gateway.admin.these_settings_apply_to_this_network_a_blank_collection'}) }}</p></div></div>
    <form method="post" action="{{ provider_network_url }}" class="mt-6 space-y-5">
        {{ _getFormSecurity({'form':'provider_network_wallets'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><input type="hidden" name="network" value="{{ provider_network }}">
        <div class="hs-provider-fields"><label><span class="mb-2 block text-sm font-bold">{{ _t({'key':'gateway.admin.collection_wallet'}) }}</span><input class="hs-provider-input font-mono" name="forward_to" value="{{ provider_network_wallets.pnForwardTo }}" placeholder="{{ _t({'key':'gateway.admin.main_ccapi_address'}) }}" maxlength="128" autocomplete="off"><small class="mt-2 block text-gray-500">{{ _t({'key':'gateway.admin.set_the_main_or_an_additional_address_for_forwarding'}) }}</small></label>
        <label><span class="mb-2 block text-sm font-bold">{{ _t({'key':'gateway.admin.payout_source_wallet'}) }}</span><input class="hs-provider-input font-mono" name="payout_from" value="{{ provider_network_wallets.pnPayoutFrom }}" placeholder="{{ _t({'key':'gateway.admin.main_ccapi_address'}) }}" maxlength="128" autocomplete="off"><small class="mt-2 block text-gray-500">{{ _t({'key':'gateway.admin.set_a_main_or_additional_ccapi_address_it_is'}) }}</small></label></div>
        <button class="hs-provider-button" type="submit" name="provider_network_wallets_btn" value="1">{{ _t({'key':'gateway.admin.save_wallets'}) }}</button>
    </form>
    {% if provider_tokens_supported %}
    <div class="mt-6 border-t border-gray-100 pt-6 dark:border-gray-800"><h3 class="text-lg font-bold">{{ _t({'key':'gateway.admin.tokens'}) }} {{ provider_network_label }}</h3><p class="mt-2 text-sm text-gray-500">{{ _t({'key':'gateway.admin.the_gateway_api_supplies_this_list_only_selected_tokens'}) }}</p>
    <form method="post" action="{{ provider_network_url }}" class="mt-4">
        {{ _getFormSecurity({'form':'provider_token_refresh'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><input type="hidden" name="network" value="{{ provider_network }}">
        <button type="submit" name="provider_token_refresh_btn" value="1" class="hs-provider-button">{{ provider_token_catalog.ptUpdatedAt|default(0) ? (_t({'key':'gateway.admin.refresh_token_list'})):(_t({'key':'gateway.admin.load_token_list'})) }}</button>
    </form>
    {% if provider_tokens %}
    <form method="post" action="{{ provider_network_url }}" class="mt-5 space-y-4" data-token-catalog>
        {{ _getFormSecurity({'form':'provider_token_add'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><input type="hidden" name="activate_selected" value="1"><input type="hidden" name="catalog_revision" value="{{ provider_token_catalog.ptRevision }}"><input type="hidden" name="network" value="{{ provider_network }}">
        <label class="block"><span class="mb-2 block text-sm font-bold">{{ _t({'key':'gateway.admin.search_by_symbol_or_contract'}) }}</span><input type="search" class="hs-provider-input" data-token-search autocomplete="off"></label>
        <div class="hs-provider-currencies" style="max-height:28rem;overflow:auto">{% for code,route in provider_tokens %}<label class="hs-provider-currency" data-token-option><span class="flex items-center gap-3"><input type="checkbox" name="tokens[]" value="{{ code }}"><strong>{{ route.asset }}</strong></span><small class="mt-2 block break-all font-mono">{{ route.contract }}</small></label>{% endfor %}</div>
        <p class="text-sm text-gray-500">{{ _t({'key':'gateway.admin.selected_currencies_are_enabled_with_financial_modes_off_after'}) }}</p>
        <button class="hs-provider-button" type="submit" name="provider_token_add_btn" value="1">{{ _t({'key':'gateway.admin.add_selected_tokens'}) }}</button>
    </form>
    {% elseif provider_token_catalog.ptUpdatedAt|default(0) %}<p class="mt-4 text-sm text-gray-500">{{ _t({'key':'gateway.admin.no_current_list_is_available_for_this_key_refresh'}) }}</p>{% endif %}</div>
    {% else %}<div class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.the_gateway_api_does_not_document_a_token_catalog'}) }}</p></div>{% endif %}
</section>

{% else %}<aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.the_network_s_native_coin_is_disconnected_existing_tokens'}) }}</p></aside>{% endif %}
{% if provider_network_connections %}<section class="card hs-provider-panel"><h3 class="mb-4 font-bold">{{ _t({'key':'gateway.admin.connected_tokens'}) }} {{ provider_network_label }}</h3>
<form name="provider_token_select" method="post" action="{{ provider_network_url }}" class="space-y-5">
    {{ _getFormSecurity({'form':'provider_token_select'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><input type="hidden" name="network" value="{{ provider_network }}">
    <div class="hs-provider-currencies">{% for token in provider_network_connections %}
        {% include 'balance/admin/currency.card.twig' with {'option_name':'token_currencies','option_value':token.cID,'option_code':token.cCurrID,'option_label':token.contract,'option_selected':token.cProviderSelected,'option_connections':[token]} %}
    {% endfor %}</div>
    <aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.deselecting_archives_only_this_token_and_preserves_its_balance'}) }}</p></aside>
    <input type="hidden" name="form_complete" value="1"><button class="hs-provider-button" type="submit" name="provider_token_select_btn" value="1">{{ _t({'key':'gateway.admin.save_network_tokens'}) }}</button>
</form></section>{% endif %}
