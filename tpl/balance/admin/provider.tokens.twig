<section class="card hs-provider-panel">
    <div class="hs-provider-section-title"><span><i class="fa-solid fa-wallet" aria-hidden="true"></i></span><div><h3>Кошельки · {{ provider_network_label }}</h3><p>Настройки относятся к этой сети. Пустые адреса используют основной кошелёк CCAPI.</p></div></div>
    <form method="post" action="{{ provider_network_url }}" class="mt-6 space-y-5">
        {{ _getFormSecurity({'form':'provider_network_wallets'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><input type="hidden" name="network" value="{{ provider_network }}">
        <div class="hs-provider-fields"><label><span class="mb-2 block text-sm font-bold">Кошелёк сбора поступлений</span><input class="hs-provider-input font-mono" name="forward_to" value="{{ provider_network_wallets.pnForwardTo }}" placeholder="Основной адрес CCAPI" maxlength="128" autocomplete="off"><small class="mt-2 block text-gray-500">Укажите основной или дополнительный адрес для пересылки средств. Пустое поле — основной адрес из настроек шлюза. Изменение действует на новые счета.</small></label>
        <label><span class="mb-2 block text-sm font-bold">Кошелёк — источник выплат</span><input class="hs-provider-input font-mono" name="payout_from" value="{{ provider_network_wallets.pnPayoutFrom }}" placeholder="Основной адрес CCAPI" maxlength="128" autocomplete="off"><small class="mt-2 block text-gray-500">Источник показывается администратору при ручной выплате. Автоматическая отправка через CCAPI не подключена.</small></label></div>
        <button class="hs-provider-button" type="submit" name="provider_network_wallets_btn" value="1">Сохранить кошельки</button>
    </form>
    {% if provider_tokens_supported %}
    <div class="mt-6 border-t border-gray-100 pt-6 dark:border-gray-800"><h3 class="text-lg font-bold">Токены · {{ provider_network_label }}</h3><p class="mt-2 text-sm text-gray-500">Список поступает из API шлюза. Добавляются только отмеченные токены. Одинаковые символы в разных сетях могут обозначать разные активы — контракт сохраняется вместе с валютой.</p>
    <form method="post" action="{{ provider_network_url }}" class="mt-4">
        {{ _getFormSecurity({'form':'provider_token_refresh'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><input type="hidden" name="network" value="{{ provider_network }}">
        <button type="submit" name="provider_token_refresh_btn" value="1" class="hs-provider-button">{{ provider_token_catalog.ptUpdatedAt|default(0) ? 'Обновить список токенов':'Загрузить список токенов' }}</button>
    </form>
    {% if provider_tokens %}
    <form method="post" action="{{ provider_network_url }}" class="mt-5 space-y-4" data-token-catalog>
        {{ _getFormSecurity({'form':'provider_token_add'}) }}<input type="hidden" name="profile_id" value="{{ provider_profile.ppID }}"><input type="hidden" name="revision" value="{{ provider_profile.ppRevision }}"><input type="hidden" name="catalog_revision" value="{{ provider_token_catalog.ptRevision }}"><input type="hidden" name="network" value="{{ provider_network }}">
        <label class="block"><span class="mb-2 block text-sm font-bold">Поиск по символу или контракту</span><input type="search" class="hs-provider-input" data-token-search autocomplete="off"></label>
        <div class="hs-provider-currencies" style="max-height:28rem;overflow:auto">{% for code,route in provider_tokens %}<label class="hs-provider-currency" data-token-option><span class="flex items-center gap-3"><input type="checkbox" name="tokens[]" value="{{ code }}"><strong>{{ route.asset }}</strong></span><small class="mt-2 block break-all font-mono">{{ route.contract }}</small></label>{% endfor %}</div>
        <p class="text-sm text-gray-500">Новые валюты создаются с отключённым приёмом. После добавления настройте лимиты, комиссии и режим пополнения.</p>
        <button class="hs-provider-button" type="submit" name="provider_token_add_btn" value="1">Добавить выбранные токены</button>
    </form>
    {% elseif provider_token_catalog.ptUpdatedAt|default(0) %}<p class="mt-4 text-sm text-gray-500">Свежего списка для этого ключа нет. Обновите каталог сети.</p>{% endif %}</div>
    {% else %}<div class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>Для этой сети текущий API шлюза не документирует каталог токенов. Приём основной монеты доступен в обычных настройках валюты.</p></div>{% endif %}
</section>

{% if provider_network_connections %}<section class="card p-6"><h3 class="mb-4 font-bold">Токены этой сети</h3><div class="grid gap-3 md:grid-cols-2">{% for token in provider_network_connections %}<a data-network-token href="{{ _link('balance/admin/curr',false,0) }}?id={{ token.cID }}" class="rounded-xl border border-gray-200 p-4 dark:border-gray-700"><strong>{{ token.cCurrID }}</strong><small class="ml-2 text-gray-500">{{ provider_profile.ppState != 'enabled' or token.cDisabled or not token.cProviderSelected or not token.cCASHINMode ? 'Приём выключен' : (token.route_enabled ? 'Приём включён' : 'Приём в этой сети выключен') }}</small><span class="mt-2 block break-all font-mono text-xs text-gray-500">{{ token.contract }}</span><span class="mt-3 block text-sm font-bold text-blue-600">Лимиты, комиссии и режимы →</span></a>{% endfor %}</div></section>{% endif %}
