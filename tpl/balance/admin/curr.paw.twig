<div class="hs-provider space-y-6">
    {% if paw_currency %}<a class="inline-flex items-center gap-2 text-sm font-bold text-blue-600" href="{{ paw_connection_url }}">{{ _t({'key':'gateway.admin.paw_payments_connection'}) }}</a>{% endif %}
    {% set paw_enabled = paw_currency ? not paw_currency_values.cDisabled : paw_profile.state == 'enabled' %}
    <div class="hs-provider-heading">
        <div class="flex min-w-0 items-center gap-4"><span class="hs-provider-icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></span><h2>PAW Payments{% if paw_currency %} — {{ paw_currency }}{% endif %}</h2></div>
        <span class="hs-provider-badge {{ paw_enabled ? 'is-enabled':'is-disabled' }}"><i class="fa-solid {{ paw_enabled ? 'fa-circle-check':'fa-circle-pause' }}" aria-hidden="true"></i>{{ paw_currency ? (paw_enabled ? (_t({'key':'gateway.admin.currency_enabled'})):(_t({'key':'gateway.admin.currency_disabled'}))) : (paw_enabled ? (_t({'key':'gateway.admin.gateway_enabled'})):(_t({'key':'gateway.admin.gateway_disabled'}))) }}</span>
    </div>
    {% if not paw_currency %}<p class="mb-6 text-sm leading-relaxed text-gray-500">{{ _t({'key':'gateway.admin.one_api_key_connects_the_gateway_configure_limits_fees'}) }}</p>{% endif %}
    {% if paw_error %}<p role="alert" class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">{{ paw_error }}</p>{% endif %}
    {% if paw_schema_ready %}
        {% if paw_profile.state == 'retired' %}
            <section class="card hs-provider-panel"><p>{{ _t({'key':'gateway.admin.this_profile_has_been_removed_currencies_recovery_keys_and'}) }}</p><a href="{{ _link('balance/admin/curr', false, 0) }}?provider=PAW" class="mt-4 inline-block underline">{{ _t({'key':'gateway.admin.open_current_connection'}) }}</a></section>
        {% elseif paw_currency %}
            <aside class="hs-provider-scope" aria-label="{{ _t({'key':'gateway.admin.currency_settings_scope'}) }}"><span class="hs-provider-scope-icon"><i class="fa-solid fa-sliders" aria-hidden="true"></i></span><div class="min-w-0"><h3>{{ _t({'key':'configurator.header.setup'}) }} {{ paw_currency }}</h3><p>{{ _t({'key':'gateway.admin.these_settings_control_only_this_currency_the_gateway_state'}) }} <a href="{{ paw_connection_url }}">{{ _t({'key':'gateway.admin.connection_page'}) }}</a>.</p></div><span class="hs-provider-scope-state {{ paw_profile.state == 'enabled' ? '':'is-disabled' }}">{{ paw_profile.state == 'enabled' ? (_t({'key':'gateway.admin.gateway_enabled'})):(_t({'key':'gateway.admin.gateway_disabled'})) }}</span></aside>
            <section class="card hs-curr-card">{% include 'balance/admin/curr.settings.twig' with {
                'currency_provider_paw':true, 'currency_preview':false, 'form':'paw_currency_save', 'url':paw_url ~ '&tab=settings', 'tpl_module':'balance/admin/curr',
                'values':paw_currency_values, 'fields':{
                    'cID':[], 'profile_id':[], 'revision':[], 'cDisabled':{0:'C',1:(_t({'key':'gateway.admin.disable_this_currency'})), 'readonly':not paw_native_ready|default(false)}, 'cHidden':{0:'C',1:(_t({'key':'gateway.admin.hide_currency_from_users'}))},
                    'cMTS':{0:'X',1:(_t({'key':'gateway.admin.updated'})),'skip':not paw_currency_values.cMTS},
                    99:(_t({'key':'gateway.admin.appearance'})), 'cName':{0:'T',1:(_t({'key':'currs.name'}))}, 'cCurrID':{0:'X',1:(_t({'key':'gateway.admin.currency_code'}))},
                    'cCurr':{0:'T',1:(_t({'key':'gateway.admin.currency_symbol'})), 'comment':(_t({'key':'gateway.admin.the_label_beside_the_amount_the_accounting_currency_code'}))},
                    'cNumDec':{0:'I',1:(_t({'key':'gateway.admin.decimal_places_0_6_0_default'})), 'min':0, 'max':6}
                }
            } %}</section>
        {% else %}
            {% include 'balance/admin/paw.referral.twig' %}
            <section class="card hs-provider-panel">
                {% include 'balance/admin/paw.form.twig' %}
                <div class="hs-provider-actions">
                    <button type="submit" form="paw-connection-save" name="paw_profile_save_btn" value="1" class="hs-provider-button">{{ _t({'key':'gateway.admin.verify_connection_and_save'}) }}</button>
                    {% if paw_profile.id %}<form method="post" action="{{ paw_url }}">{{ _getFormSecurity({'form':'paw_profile_manage'}) }}<input type="hidden" name="profile_id" value="{{ paw_profile.id }}"><input type="hidden" name="revision" value="{{ paw_profile.revision }}"><button type="submit" name="paw_profile_manage_btnremove" value="1" class="hs-provider-button hs-provider-button--remove">{{ _t({'key':'gateway.admin.archive_gateway_and_all_its_currencies'}) }}</button></form>{% endif %}
                </div>
            </section>
        {% endif %}
    {% endif %}
</div>
