<div class="hs-provider-currency h-full">
    {% if not option_activation_disabled|default(false) %}<input type="hidden" name="activation_scope[]" value="{{ option_value }}">{% endif %}
    <label class="flex items-center gap-3 font-bold">
        <input type="checkbox" name="{{ option_name }}[]" value="{{ option_value }}"{% if option_selected %} checked{% endif %}{% if option_readonly|default(false) %} disabled{% endif %}>
        <span>{{ option_code }}<small class="mt-1 block text-sm font-normal text-gray-500">{{ option_label }}</small></span>
    </label>
    {% if option_connections or option_network|default(false) %}<div class="hs-provider-currency-actions">{% for connection in option_connections %}
        <a href="{{ _link('balance/admin/curr',false,0) }}?id={{ connection.cID }}" aria-labelledby="currency-title-{{ connection.cID }}" aria-describedby="currency-hint-{{ connection.cID }}"><i class="fa-solid fa-sliders" aria-hidden="true"></i><span><strong id="currency-title-{{ connection.cID }}">{{ _t({'key':'configurator.modules.configure'}) }} {{ option_code }}</strong><small id="currency-hint-{{ connection.cID }}">{{ option_hint|default((_t({'key':'gateway.admin.limits_fees_and_availability'}))) }}{% if option_connections|length > 1 %} · #{{ connection.cID }}{% endif %}</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
        {% if connection.network_url|default(false) %}<a class="is-network" href="{{ _link('balance/admin/curr',false,0) }}{% if connection.network_key|default(false) %}?provider=PAYKASSA&amp;tab=network&amp;network={{ connection.network_key }}{% else %}?id={{ connection.cID }}&amp;tab=network{% endif %}" aria-labelledby="network-title-{{ connection.cID }}" aria-describedby="network-hint-{{ connection.cID }}"><i class="fa-solid fa-wallet" aria-hidden="true"></i><span><strong id="network-title-{{ connection.cID }}">{{ connection.network_title|default((_t({'key':'gateway.admin.wallets_and_tokens'}))) }}</strong><small id="network-hint-{{ connection.cID }}">{{ connection.network_hint|default((_t({'key':'gateway.admin.collection_address_and_payout_source'}))) }}</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>{% endif %}
    {% endfor %}
    {% if option_network|default(false) %}<a class="is-network" href="{{ _link('balance/admin/curr',false,0) }}?provider=PAYKASSA&amp;tab=network&amp;network={{ option_network.key }}" aria-label="{{ _t({'key':'gateway.admin.tokens'}) }} {{ option_network.label }}"><i class="fa-solid fa-wallet" aria-hidden="true"></i><span><strong>{{ _t({'key':'gateway.admin.network_tokens'}) }}</strong><small>{{ option_network.label }}</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>{% endif %}
    </div>{% endif %}
{% if option_activation_disabled|default(false) %}<p class="mt-3 text-sm text-gray-500">{{ _t({'key':'gateway.admin.this_group_has_multiple_accounts_enable_the_required_account'}) }}</p>{% endif %}
</div>
