{% set opers_filter_values = valueIf(isset(_SESSION[edit_form_name]), _SESSION[edit_form_name], []) %}
{% include "edit.twig" with {"form": 'opers_filter', "url": '*', "values": opers_filter_values, "fields": {'uLogin': {0: 'T', 1: _t({"key": 'common.user', "default": 'Пользователь'}), 'size': 10}, 'oOper': {0: 'S', 1: _t({"key": 'opers.filter.oper', "default": 'Операция'}), 2: 0, 3: merge_arrays([_t({"key": 'common.all', "default": '- все -'})], op_names)}, 'ocID': {0: 'S', 1: _t({"key": 'opers.filter.psys', "default": 'Плат.система'}), 2: 0, 3: merge_arrays([_t({"key": 'common.all', "default": '- все -'})], currs)}, 'oBatch': {0: 'T', 1: _t({"key": 'opers.filter.batch', "default": 'Batch-номер'}), 'size': 10}, 'oState': {0: 'S', 1: _t({"key": 'opers.filter.state', "default": 'Статус'}), 2: 0, 3: merge_arrays({9: _t({"key": 'common.all', "default": '- все -'})}, op_statuses), 'default': 9}, 'oMemo': {0: 'T', 1: '<i>'|cat(_t({"key": 'opers.filter.memo', "default": 'Примечание'}))|cat('</i>'), 'size': 20}}, "btn_text": _t({"key": 'opers.button.filter', "default": 'Отфильтровать'}), "btns": valueIf(isset(_SESSION[edit_form_name]), {'clear': _t({"key": 'opers.button.clear', "default": 'Показать все'})})} %}

{% include "list.twig" with {"title": opers_title_text|cat(valueIf(isset(_SESSION[edit_form_name]), (' (' ~ _t({"key": 'opers.filtered', "default": 'отфильтровано'}) ~ ')'))) , "url": '*', "fields": {'oID': [_t({"key": 'common.id', "default": 'ID'})], 'uLogin': [_t({"key": 'common.user', "default": 'Пользователь'})], 'oTS': [_t({"key": 'opers.col.ts', "default": 'Создано / Обработано'})], 'oOper': [_t({"key": 'opers.col.oper', "default": 'Операция'})], 'oCID': [_t({"key": 'opers.col.psys', "default": 'Плат. система / Счёт'})], 'oSum': [_t({"key": 'opers.col.sum', "default": 'Сумма / Комиссия'})], 'oBatch': [_t({"key": 'opers.col.batch', "default": 'Batch-номер'})], 'oState': [_t({"key": 'opers.col.state', "default": 'Статус'})], 'oMemo': [_t({"key": 'opers.col.memo', "default": 'Примечание'})]}, "values": list, "row": '*', "btns": {'complete': _t({"key": 'opers.btn.complete', "default": 'Выполнить'}), 'confirm': _t({"key": 'opers.btn.confirm', "default": 'Подтв. выполнение'}), 'cancel': _t({"key": 'opers.btn.cancel', "default": 'Отклонить'}), 'del': _t({"key": 'common.delete', "default": 'Удалить'})}, "linkparams": linkparams} %}

