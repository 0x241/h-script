{% set partner_name = provider_kind == 'PAYKASSA' ? 'PayKassa':(provider_kind == 'VOLET' ? 'Volet':'CryptoCurrencyAPI') %}
<aside class="hs-provider-partner overflow-hidden rounded-2xl border border-blue-100 bg-blue-50/50 dark:border-blue-900 dark:bg-blue-950/30">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-blue-100 px-6 py-5 dark:border-blue-900">
        <div class="flex items-center gap-3"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-200"><i class="fa-solid fa-handshake" aria-hidden="true"></i></span><div><h3 class="font-extrabold text-brand dark:text-white">{{ _t({'key':'sms.setup.reg'}) }} {{ partner_name }}{% if provider_kind != 'VOLET' %} {{ _t({'key':'gateway.admin.and_h_script_cashback'}) }}{% endif %}</h3><p class="mt-1 text-xs text-gray-500">{{ _t({'key':'gateway.admin.partner_program'}) }}</p></div></div>
        {% if provider_referral_url %}<a href="{{ provider_referral_url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white">{{ _t({'key':'gateway.admin.open_the_h_script_partner_link'}) }} <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i></a>{% else %}<span class="rounded-xl border border-blue-100 bg-white/70 px-4 py-2.5 text-xs font-semibold text-blue-800 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-200">{{ _t({'key':'gateway.admin.partner_link_coming_soon'}) }}</span>{% endif %}
    </div>
    <ol class="grid gap-5 px-6 py-5 text-sm sm:grid-cols-3">
        <li><span class="mb-2 block text-xs font-extrabold uppercase tracking-wider text-blue-600">{{ _t({'key':'gateway.admin.01_registration'}) }}</span><p class="leading-relaxed text-gray-600 dark:text-gray-300">{{ _t({'key':'gateway.admin.register_with'}) }} {{ partner_name }} {{ _t({'key':'gateway.admin.using_the_h_script_partner_link'}) }}</p></li>
        <li><span class="mb-2 block text-xs font-extrabold uppercase tracking-wider text-blue-600">{{ _t({'key':'gateway.admin.02_api_key'}) }}</span><p class="leading-relaxed text-gray-600 dark:text-gray-300">{% if provider_kind == 'PAYKASSA' %}{{ _t({'key':'gateway.admin.create_a_merchant_configure_sci_notification_urls_issue_an'}) }}{% elseif provider_kind == 'VOLET' %}{{ _t({'key':'gateway.admin.create_the_required_wallets_and_connect_sci_for_payment'}) }}{% else %}{{ _t({'key':'gateway.admin.create_wallets_for_the_required_networks_issue_a_shared'}) }}{% endif %}</p></li>
        <li><span class="mb-2 block text-xs font-extrabold uppercase tracking-wider text-blue-600">{{ _t({'key':'gateway.admin.03_connection'}) }}</span><p class="leading-relaxed text-gray-600 dark:text-gray-300">{% if provider_kind == 'PAYKASSA' %}{{ _t({'key':'gateway.admin.enter_the_merchant_id_sci_password_api_id_and'}) }}{% elseif provider_kind == 'VOLET' %}{{ _t({'key':'gateway.admin.enter_sci_and_api_credentials_once_then_choose_a'}) }}{% else %}{{ _t({'key':'gateway.admin.enter_the_key_once_connect_networks_and_select_tokens'}) }}{% endif %}</p></li>
    </ol>
    <div class="flex items-start gap-3 border-t border-blue-100 bg-blue-50 px-6 py-4 text-sm leading-relaxed text-blue-950 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-100"><i class="fa-solid fa-circle-info mt-1 shrink-0" aria-hidden="true"></i><p>{% if provider_kind == 'PAYKASSA' %}<strong>{{ _t({'key':'gateway.admin.cashback_is_paid_manually_after_reconciling_transactions_in_paykassa'}) }}</strong> {{ _t({'key':'gateway.admin.it_is_not_credited_automatically_to_the_h_script'}) }}{% elseif provider_kind == 'VOLET' %}{{ _t({'key':'gateway.admin.ask_volet_about_partner_program_terms_registering_through_the'}) }}{% else %}<strong>{{ _t({'key':'gateway.admin.cashback_is_paid_manually_after_reconciling_transactions_in_cryptocurrencyapi'}) }}</strong> {{ _t({'key':'gateway.admin.it_is_not_credited_automatically_to_the_h_script'}) }}{% endif %}</p></div>
</aside>
