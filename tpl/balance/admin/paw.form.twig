{% set fiat_names = {'USD':(_t({'key':'gateway.admin.us_dollar'})),'EUR':(_t({'key':'gateway.admin.euro'})),'GBP':(_t({'key':'gateway.admin.pound_sterling'})),'CAD':(_t({'key':'gateway.admin.canadian_dollar'})),'AUD':(_t({'key':'gateway.admin.australian_dollar'})),'CHF':(_t({'key':'gateway.admin.swiss_franc'})),'JPY':(_t({'key':'gateway.admin.japanese_yen'})),'NZD':(_t({'key':'gateway.admin.new_zealand_dollar'})),'SGD':(_t({'key':'gateway.admin.singapore_dollar'})),'HKD':(_t({'key':'gateway.admin.hong_kong_dollar'})),'NGN':(_t({'key':'gateway.admin.nigerian_naira'})),'KRW':(_t({'key':'gateway.admin.south_korean_won'})),'ILS':(_t({'key':'gateway.admin.israeli_shekel'})),'RON':(_t({'key':'gateway.admin.romanian_leu'})),'ARS':(_t({'key':'gateway.admin.argentine_peso'})),'INR':(_t({'key':'gateway.admin.indian_rupee'})),'IDR':(_t({'key':'gateway.admin.indonesian_rupiah'})),'MXN':(_t({'key':'gateway.admin.mexican_peso'})),'MYR':(_t({'key':'gateway.admin.malaysian_ringgit'})),'TRY':(_t({'key':'gateway.admin.turkish_lira'})),'PLN':(_t({'key':'gateway.admin.polish_zloty'})),'BRL':(_t({'key':'gateway.admin.brazilian_real'})),'THB':(_t({'key':'gateway.admin.thai_baht'}))} %}
<form id="paw-connection-save" method="post" action="{{ paw_url }}" class="space-y-6">
    {{ _getFormSecurity({'form':'paw_profile_save'}) }}
    <input type="hidden" name="profile_id" value="{{ paw_profile.id }}"><input type="hidden" name="revision" value="{{ paw_profile.revision }}">
    <div class="hs-provider-section-title"><span>1</span><div><h3>{{ _t({'key':'gateway.admin.gateway_connection'}) }}</h3><p>{{ _t({'key':'gateway.admin.one_shared_api_key_for_all_selected_h_script'}) }}</p></div></div>
    <label class="block"><span class="mb-2 block text-sm font-bold">{{ _t({'key':'gateway.admin.paw_api_key'}) }}</span><input id="paw-api-key" class="hs-provider-input" type="password" name="api_key" value="" autocomplete="new-password" spellcheck="false" maxlength="4096" placeholder="{{ paw_profile.has_key ? (_t({'key':'gateway.admin.saved_leave_blank_to_keep_unchanged'})):(_t({'key':'gateway.admin.enter_key'})) }}" {% if not paw_profile.has_key %}required{% endif %}><small class="mt-2 block text-gray-500">{{ _t({'key':'gateway.admin.the_key_determines_the_sandbox_or_live_environment_the'}) }}</small></label>
    <label class="hs-provider-enabled"><input type="hidden" name="enabled" value="0"><input type="checkbox" name="enabled" value="1" {% if paw_profile.state == 'enabled' or not paw_profile.id %}checked{% endif %}><span>{{ _t({'key':'gateway.admin.gateway_enabled'}) }}<small class="mt-1 block font-normal text-gray-500">{{ _t({'key':'gateway.admin.disabling_turns_off_currencies_and_payment_acceptance_fees_limits'}) }}</small></span></label>
    <div><div class="hs-provider-section-title"><span>2</span><div><h3>{{ _t({'key':'gateway.admin.accounting_currencies'}) }}</h3><p>{{ _t({'key':'gateway.admin.each_currency_has_its_own_balance_limits_and_fees'}) }}</p></div></div>
        <div class="hs-provider-currencies">{% for fiat in paw_fiats %}{% set connection=null %}{% for candidate in paw_profile.connections %}{% if candidate.cCurrID == fiat %}{% set connection=candidate %}{% endif %}{% endfor %}
            {% include 'balance/admin/currency.card.twig' with {'option_name':'fiats','option_value':fiat,'option_code':fiat,'option_label':fiat_names[fiat]|default(fiat),'option_selected':fiat in paw_selected,'option_connections':connection ? [connection]:[]} %}
        {% endfor %}</div>
        <aside class="hs-provider-note hs-provider-network-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>{{ _t({'key':'gateway.admin.selecting_enables_the_currency_deposit_and_withdrawal_modes_are_80'}) }}</p></aside>
    </div>
    <input type="hidden" name="form_complete" value="1">
</form>
