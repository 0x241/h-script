<div class="space-y-4" data-currency-rates>
    <p class="text-sm text-gray-500">{{ _t({'key':'rates.description','default':'Стоимость одной единицы валюты в единицах внутренней валюты. Нулевой курс запрещает обмен. Курсы общие для шлюзов с одинаковой валютой учёта.'}) }}</p>
    <label class="flex items-center gap-3 rounded-xl bg-gray-50 p-3 dark:bg-gray-900"><input type="hidden" name="UpdateRates" value="0"><input type="checkbox" name="UpdateRates" value="1" {% if cfg.UpdateRates|default(0) %}checked{% endif %}><span>{% if rate_uses_cbr %}{{ _t({'key':'rates.cbr','default':'Обновлять USD, EUR и RUB по ЦБ РФ'}) }}{% else %}{{ _t({'key':'rates.fiat_coinbase','default':'Обновлять USD, EUR и RUB через Coinbase'}) }}{% endif %}</span><small class="text-gray-500">{{ lastupdate }}</small></label>
    <div class="max-h-[32rem] overflow-auto rounded-xl border border-gray-200 dark:border-gray-800">
        <table class="w-full text-left text-sm"><thead class="sticky top-0 bg-gray-50 dark:bg-gray-900"><tr><th class="p-3">{{ _t({'key':'rates.currency','default':'Валюта'}) }}</th><th class="p-3">{{ _t({'key':'rates.value','default':'Курс за единицу'}) }}</th><th class="p-3">{{ _t({'key':'rates.auto','default':'Автообновление'}) }}</th></tr></thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">{% for code,row in rate_currencies %}<tr><th class="p-3 font-bold" scope="row"><label for="rate-{{ code }}">{{ code }}</label><span class="mt-1 block max-w-72 text-xs font-normal text-gray-500">{{ row.providers|join(', ') }}</span></th><td class="p-3"><input id="rate-{{ code }}" name="Rate{{ code }}" inputmode="decimal" class="w-full min-w-32 rounded-lg border border-gray-200 bg-transparent px-3 py-2 font-mono dark:border-gray-700" maxlength="32" value="{{ cfg['Rate' ~ code]|default('0') }}" aria-label="{{ code }}"></td><td class="p-3">{% if row.central_bank %}<span class="text-xs text-gray-500">{% if rate_uses_cbr %}{{ _t({'key':'rates.cbr_group','default':'Общий флаг ЦБ РФ'}) }}{% else %}{{ _t({'key':'rates.fiat_group','default':'Общий флаг USD / EUR / RUB'}) }}{% endif %}</span>{% else %}<label class="inline-flex items-center gap-2"><input type="hidden" name="Update{{ code }}Rate" value="0"><input name="Update{{ code }}Rate" value="1" type="checkbox" {% if cfg['Update' ~ code ~ 'Rate']|default(0) %}checked{% endif %}><span class="text-xs">Coinbase</span></label>{% endif %}</td></tr>{% endfor %}</tbody></table>
    </div>
    <p class="text-xs text-gray-500">{{ _t({'key':'rates.tokens','default':'Произвольные токены различаются по сети и контракту. Курс совпадающего символа к ним не применяется; автоматический обмен таких токенов остаётся недоступен.'}) }}</p>
</div>
