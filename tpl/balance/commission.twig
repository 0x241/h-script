<div id="operation-commission" class="flex min-h-[60px] items-center justify-between gap-4 rounded-2xl border border-gray-100 bg-gray-50 p-4 dark:border-gray-800 dark:bg-[#1A1A1A]">
	<span class="text-sm font-bold text-gray-500">{{ _t({"key": "opers.comis", "default": "Комиссия"}) }}</span>
	{% if commission_ready %}
		<span class="text-right font-mono text-lg font-bold text-amber-500">{{ _z(commission_value, commission_cid, -1) }}</span>
	{% else %}
		<span class="text-right text-sm font-semibold text-gray-400">&mdash;</span>
	{% endif %}
</div>
