

{% if pform.url %}

	<br>
	<div class="hs-payment-form">
	<form method="{% if pform.get %}get{% else %}post{% endif %}" action="{{ pform.url }}" name="pay_form"{% if pay_auto_submit %} data-hs-auto-submit="1"{% endif %}>
		{% for f, v in pform %}
			{% if (f != 'url') and (f != 'get') %}
				<input name="{{ f }}" value="{{ v }}" type="hidden">
			{% endif %}
		{% endfor %}
		<input value="{% if btn_text %}{{ btn_text }}{% else %}{{ _t({"key": 'payment.goto'}) }}{% endif %}" type="submit" class="button-green">
	</form>
	</div>
	
{% endif %}
	
