
{% include "admin/header.twig" with {"title": 'Настройки'} %}

{% if not isset(cfg.Enabled) %}{% set cfg = array_set_path(cfg|default([]), ["Enabled"], 1) %}{% endif %}

<div class="mb-6 overflow-hidden rounded-[1.5rem] border border-blue-100 bg-blue-50/60 shadow-sm dark:border-blue-500/20 dark:bg-blue-500/5">
	<div class="flex flex-col gap-5 p-6 lg:flex-row lg:items-start lg:justify-between">
		<div class="flex min-w-0 gap-4">
			<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-500 text-white shadow-sm">
				<i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
			</span>
			<div class="min-w-0">
				<h2 class="text-lg font-extrabold text-brand dark:text-white">Автономный режим планировщика</h2>
				<p class="mt-1 max-w-3xl text-sm leading-6 text-gray-600 dark:text-gray-400">В Docker отдельный cron-контейнер уже вызывает планировщик раз в минуту. На shared hosting сначала добавьте команду ниже в раздел Cron/Планировщик панели хостинга с периодом «каждую минуту», а затем включите переключатель «Автономный вызов настроен».</p>
			</div>
		</div>
		<a href="{{ fullURL(moduleToLink('cron')) }}" target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl border border-blue-200 bg-white px-5 py-3 text-sm font-extrabold text-blue-600 transition hover:border-blue-300 hover:bg-blue-50 dark:border-blue-500/30 dark:bg-[#151515] dark:text-blue-400 dark:hover:bg-blue-500/10">
			<i class="fa-solid fa-play" aria-hidden="true"></i>
			<span>Вызвать вручную</span>
		</a>
	</div>
	<div class="border-t border-blue-100 bg-white/70 px-6 py-4 dark:border-blue-500/20 dark:bg-[#111111]/60">
		<code class="block overflow-x-auto whitespace-nowrap font-mono text-xs font-semibold text-gray-700 dark:text-gray-300">wget -q -O /dev/null "{{ fullURL(moduleToLink('cron')) }}" &gt; /dev/null 2&gt;&amp;1</code>
	</div>
</div>

{% include "edit.twig" with {"values": cfg, "fields": {
		'Enabled': ['C', 'Планировщик включен']
	} } %}

{% if cfg.Enabled and cronlist %}
	<section class="mt-6 overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm dark:border-gray-800 dark:bg-[#151515]">
		<header class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-6 py-5 dark:border-gray-800">
			<div>
				<h2 class="text-lg font-bold text-brand dark:text-white">Статистика вызовов</h2>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Последний запуск и периодичность фоновых модулей.</p>
			</div>
			<span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-bold text-gray-500 dark:bg-[#202020] dark:text-gray-300">Всего: {{ count(cronlist) }}</span>
		</header>
		<div class="overflow-x-auto">
			<table class="w-full min-w-[620px] border-collapse text-left">
				<thead>
					<tr class="border-b border-gray-100 bg-gray-50/70 text-xs uppercase text-gray-400 dark:border-gray-800 dark:bg-[#1A1A1A]">
						<th class="px-6 py-3 font-bold">Модуль</th>
						<th class="px-6 py-3 font-bold">Периодичность</th>
						<th class="px-6 py-3 text-right font-bold">Последний вызов</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100 dark:divide-gray-800">
					{% for item in cronlist %}
						{% set is_overdue = item.has_run and item.minutes > (item.interval * 2) %}
						<tr>
							<td class="px-6 py-4">
								<span class="inline-flex items-center gap-3 font-bold text-brand dark:text-white"><i class="fa-solid fa-cube text-gray-400" aria-hidden="true"></i>{{ item.module|capitalize }}</span>
							</td>
							<td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">Каждые {{ item.interval }} мин.</td>
							<td class="px-6 py-4 text-right">
								<span class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-bold {% if not item.has_run %}bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-300{% elseif is_overdue %}bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-300{% else %}bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300{% endif %}">
									<i class="fa-solid fa-circle text-[7px]" aria-hidden="true"></i>
									{% if not item.has_run %}Еще не запускался{% elseif item.minutes < 1 %}Только что{% elseif item.minutes < 1440 %}{{ item.minutes }} мин. назад{% else %}Более суток назад{% endif %}
								</span>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</section>
{% endif %}

{% include "admin/footer.twig" %}
