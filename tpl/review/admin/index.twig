
{% set review_title_text = _t({"key": 'reviews.title', "default": 'Отзывы'}) %}
{% include "admin/header.twig" with {"title": review_title_text} %}

{% include "list.twig" with {"title": review_title_text, "url": '*', "fields": {'oID': [_t({"key": 'common.id', "default": 'ID'})], 'oTS': [_t({"key": 'common.date', "default": 'Дата'})], 'uLogin': [_t({"key": 'reviews.author', "default": 'Автор'})], 'oText': [_t({"key": 'reviews.field.text', "default": 'Текст'})], 'oRating': [_t({"key": 'reviews.rating', "default": 'Оценка'})], 'oState': ['<small>'|cat(_t({"key": 'reviews.approved', "default": 'Одобрен'}))|cat('</small>')], 'oOrder': ['<small>'|cat(_t({"key": 'common.weight', "default": 'Вес'}))|cat('</small>')], '_Action': [_t({"key": 'common.action', "default": 'Действие'})]}, "values": list, "row": '*', "btns": {'accept': _t({"key": 'reviews.approve', "default": 'Одобрить'}), 'del': _t({"key": 'common.delete', "default": 'Удалить'})}} %}

<div class="mt-6 flex justify-center">
	<a href="{{ _link('review/admin/review', false, 0) }}?add" class="inline-flex min-w-48 items-center justify-center gap-2 rounded-xl bg-brand px-6 py-3 text-sm font-extrabold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-black dark:bg-white dark:text-brand dark:hover:bg-gray-100">
		<i class="fa-solid fa-circle-plus" aria-hidden="true"></i>
		<span>{{ _t({"key": 'common.add', "default": 'Добавить'}) }}</span>
	</a>
</div>

{% include "admin/footer.twig" %}
