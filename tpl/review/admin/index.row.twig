
<td>
	<a href="{{ _link('review/admin/review', false, 0) }}?id={{ l.oID }}">#{{ l.oID }}</a>
</td>
<td class="nowrap">
	<small>{{ l.oTS }}</small>
</td>
<td>
	<a href="{{ _link('account/admin/user', false, 0) }}?id={{ l.ouID }}">{{ l.uLogin }}</a>
</td>
<td class="w-full min-w-72 max-w-xl whitespace-normal">
	<details class="group max-w-xl">
		<summary class="cursor-pointer list-none text-sm text-gray-500 marker:hidden dark:text-gray-400">
			<span class="block max-h-10 overflow-hidden whitespace-normal leading-5 group-open:hidden">{{ l.oText }}</span>
			<span class="inline-flex items-center gap-2 text-xs font-bold text-blue-500 group-open:hidden">
				<i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
				{{ _t({"key": 'common.read_full', "default": 'Читать полностью'}) }}
			</span>
			<span class="hidden items-center gap-2 text-xs font-bold text-blue-500 group-open:inline-flex">
				<i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
				{{ _t({"key": 'common.collapse', "default": 'Свернуть'}) }}
			</span>
		</summary>
		<div class="mt-3 max-h-64 overflow-y-auto whitespace-pre-wrap rounded-xl bg-gray-50 p-4 text-sm leading-6 text-brand dark:bg-[#1A1A1A] dark:text-gray-200">{{ l.oText }}</div>
	</details>
</td>
<td>
	<span class="inline-flex items-center gap-0.5 text-xs" title="{{ l.oRating|default(5) }} / 5">
		{% for star in 1..5 %}
			<i class="{% if star <= l.oRating|default(5) %}fa-solid text-amber-400{% else %}fa-regular text-gray-300 dark:text-gray-700{% endif %} fa-star" aria-hidden="true"></i>
		{% endfor %}
	</span>
</td>
<td>
	{% if l.oState %}Да{% endif %}
</td>
<td>
	{{ l.oOrder }}
</td>
<td>
	<a href="{{ _link('review/admin/review', false, 0) }}?id={{ l.oID }}" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-500 dark:border-gray-800 dark:bg-[#151515] dark:text-gray-400 dark:hover:border-blue-500/30 dark:hover:bg-blue-500/10 dark:hover:text-blue-400" title="{{ _t({"key": 'common.edit', "default": 'Редактировать'}) }}">
		<i class="fa-solid fa-pen" aria-hidden="true"></i>
		<span class="sr-only">{{ _t({"key": 'common.edit', "default": 'Редактировать'}) }}</span>
	</a>
</td>
