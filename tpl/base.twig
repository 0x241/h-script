{% set current_theme = 'light' %}
{% if isset(_COOKIE.theme) and _COOKIE.theme == 'dark' %}
	{% set current_theme = 'dark' %}
{% elseif user.uTheme == 'dark' %}
	{% set current_theme = 'dark' %}
{% endif %}
<!doctype html>
<html lang="{{ current_lang|default('ru') }}" class="{{ current_theme }}" data-theme="{{ current_theme }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}{{ _cfg.Sys_SiteName|default('H-Script CMS') }}{% endblock %}</title>
		<base href="{{ root_url|default('') }}">
		<link rel="icon" type="image/svg+xml" href="favicon.svg">
		<link rel="stylesheet" href="static/lib/fonts/inter/5.3.0/font.css">
		<link rel="stylesheet" href="static/lib/fonts/jetbrains-mono/5.3.0/font.css">
		<link rel="stylesheet" href="static/lib/fontawesome/6.5.1/css/all.min.css">
		<link rel="stylesheet" type="text/css" href="static/css/app.css?v=tailwind-20261022-provider-width1">
		<link rel="stylesheet" href="static/css/htmx-indicator.css?v=20260929-csp1">
		<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false}'>
		<script src="static/js/htmx.min.js"></script>
		<script src="static/js/app.js?v=20261017-provider-ux1" defer></script>
		{% block head %}{% endblock %}
	</head>
	<body class="min-h-screen bg-bgLight text-brand antialiased dark:bg-[#0A0A0A] dark:text-gray-100 {{ body_class|default('') }}">
		<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:text-sm focus:font-bold focus:text-white dark:focus:bg-white dark:focus:text-brand" href="#content">{{ _t({'key': 'site.skip_content', 'default': 'Перейти к содержимому'}) }}</a>
		{% block sidebar %}{% endblock %}
		<main id="content" class="min-h-screen">
			{% block content %}{% endblock %}
		</main>
		{% block scripts %}{% endblock %}
	</body>
</html>
