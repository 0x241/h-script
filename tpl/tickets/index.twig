{% include "header.twig" with {"title": _t({"key": 'tickets.title', "default": 'Поддержка'})} %}

<div class="mx-auto w-full max-w-6xl">
	<div class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
		<div>
			<h2 class="mb-2 text-3xl font-bold text-brand dark:text-white">{{ _t({"key": 'tickets.heading', "default": 'Ваши обращения'}) }}</h2>
			<p class="text-textDim dark:text-gray-400">{{ _t({"key": 'tickets.text', "default": 'Связь со службой технической поддержки.'}) }}</p>
		</div>
		<a href="{{ _link('tickets/ticket', false, 0) }}?add" class="hs-action hs-action--primary">
			<i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
			{{ _t({"key": 'tickets.create', "default": 'Создать тикет'}) }}
		</a>
	</div>

	<div class="overflow-hidden rounded-[1.5rem] border border-gray-100 bg-white shadow-sm dark:border-gray-800 dark:bg-[#151515]">
		<div class="overflow-x-auto">
			<table class="w-full min-w-[760px] border-collapse text-left">
				<thead>
					<tr class="border-b border-gray-100 bg-gray-50/50 dark:border-gray-800 dark:bg-[#1A1A1A]">
						<th class="w-24 px-6 py-4 text-sm font-bold text-gray-500">{{ _t({"key": 'common.id', "default": 'ID'}) }}</th>
						<th class="px-6 py-4 text-sm font-bold text-gray-500">{{ _t({"key": 'tickets.col.topic', "default": 'Тема обращения'}) }}</th>
						<th class="px-6 py-4 text-sm font-bold text-gray-500">{{ _t({"key": 'tickets.col.updated', "default": 'Обновлено'}) }}</th>
						<th class="px-6 py-4 text-right text-sm font-bold text-gray-500">{{ _t({"key": 'tickets.col.status', "default": 'Статус'}) }}</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100 text-sm dark:divide-gray-800">
					{% for id, l in list %}
						{% set state_label = _tstates[l.tState]|default(l.tState) %}
						{% set state_class = 'bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400' %}
						{% if l.tState == 2 %}
							{% set state_class = 'bg-amber-100 text-amber-600 dark:bg-amber-900/30 dark:text-amber-500' %}
						{% elseif l.tState == 5 %}
							{% set state_class = 'bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400' %}
						{% elseif l.tState < 8 %}
							{% set state_class = 'bg-emerald-100 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400' %}
						{% endif %}
						<tr class="transition-colors hover:bg-gray-50 dark:hover:bg-[#1A1A1A]">
							<td class="px-6 py-5 font-mono text-gray-400">#{{ l.tID }}</td>
							<td class="px-6 py-5">
								<a href="{{ _link('tickets/ticket', false, 0) }}?id={{ l.tID }}" class="font-bold text-base text-brand transition-colors hover:text-blue-500 dark:text-white dark:hover:text-blue-400">{{ l.tTopic }}</a>
								<div class="mt-1 text-xs text-gray-500">{{ _t({"key": 'tickets.replies', "count": l.cnt, "default": 'Ответов'}) }}: {{ l.cnt }}</div>
							</td>
							<td class="px-6 py-5 text-gray-500">{{ l.tLTS }}</td>
							<td class="px-6 py-5 text-right">
								<span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold {{ state_class }}">
									{% if l.tState == 5 %}<span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>{% endif %}
									{{ state_label }}
								</span>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4" class="px-6 py-12 text-center">
								<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-100 text-xl text-gray-400 dark:bg-[#202020]"><i class="fa-solid fa-headset" aria-hidden="true"></i></div>
								<div class="text-lg font-bold text-brand dark:text-white">{{ _t({"key": 'list.empty', "default": 'Нет записей'}) }}</div>
								<div class="mt-1 text-sm text-gray-400">{{ _t({"key": 'tickets.empty', "default": 'У вас пока нет обращений в поддержку.'}) }}</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		{% include "pl.twig" %}
	</div>
</div>

{% include "footer.twig" %}
