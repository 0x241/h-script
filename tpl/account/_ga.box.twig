
{% if not user.aGA %}
	<input name="GAKey" value="{{ GACode }}" type="hidden">
	<div class="hs-ga-box" style="display: flex; align-items: center; gap: 24px; background: var(--color-surface); padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--color-border); margin-bottom: 12px;">
		{% if GAQR %}
			<div class="hs-ga-qr" style="flex-shrink: 0; background: #fff; padding: 10px; border-radius: 8px; border: 1px solid #ddd;">
				<img src="{{ GAQR }}" alt="QR Code" style="width: 110px; height: 110px; display: block;">
			</div>
		{% endif %}
		<div style="flex-grow: 1;">
			<strong style="display: block; font-size: 1.05rem; color: var(--color-primary-ink); margin-bottom: 6px;">Сканируйте QR-код</strong>
			<p style="color: var(--color-text-muted); font-size: 0.88rem; margin: 0 0 12px; line-height: 1.4;">Откройте приложение <a href="https://www.google.com/landing/2step/" target="_blank" rel="noopener noreferrer" style="color: var(--color-accent); text-decoration: underline;">Google Authenticator</a> и отсканируйте код слева или введите секретный ключ вручную:</p>
			<div class="hs-ga-key" style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-accent); background: var(--color-surface-muted); padding: 8px 14px; border-radius: 6px; display: inline-block; border: 1px solid var(--color-border); letter-spacing: 0.1em;">{{ GACode }}</div>
		</div>
	</div>
{% else %}
	<div class="hs-ga-box hs-ga-box--active" style="display: flex; align-items: center; gap: 16px; background: color-mix(in srgb, var(--color-success) 10%, var(--color-surface)); border: 1px solid var(--color-success); padding: 20px; border-radius: var(--radius-md); margin-bottom: 12px;">
		<span style="font-size: 2.2rem; color: var(--color-success);"><i class="fa-solid fa-shield-halved"></i></span>
		<div>
			<strong style="display: block; font-size: 1.05rem; color: var(--color-success); margin-bottom: 4px;">Google Authenticator подключен</strong>
			<p style="color: var(--color-text-muted); font-size: 0.88rem; margin: 0;">Для отключения защиты введите текущий одноразовый код подтверждения из приложения.</p>
		</div>
	</div>
{% endif %}
