# Публичные DNS-имена. Оба указывают на VPS-шлюз с Nginx и Authelia.
HS_PUBLIC_HOST=hs.example.com
AUTHELIA_PUBLIC_HOST=sso.example.com

# Постоянный Tailscale IP VPS с H-Script и опубликованный порт приложения.
HS_TAILSCALE_IP=100.64.0.20
HS_UPSTREAM_PORT=8080

# Постоянный Tailscale IP VPS-шлюза с Nginx и Authelia.
GATEWAY_TAILSCALE_IP=100.64.0.10

# Native/systemd Authelia слушает только loopback VPS-шлюза.
AUTHELIA_LISTEN_IP=127.0.0.1
AUTHELIA_LISTEN_PORT=9091

# Пути к сертификатам могут совпадать, только если один сертификат содержит
# оба DNS-имени в Subject Alternative Name.
HS_TLS_CERTIFICATE=/etc/letsencrypt/live/hs.example.com/fullchain.pem
HS_TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/hs.example.com/privkey.pem
AUTHELIA_TLS_CERTIFICATE=/etc/letsencrypt/live/sso.example.com/fullchain.pem
AUTHELIA_TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/sso.example.com/privkey.pem
ACME_WEBROOT=/var/www/letsencrypt

# Эти значения задаются на VPS H-Script.
APP_BIND_IP=${HS_TAILSCALE_IP}
APP_PORT=${HS_UPSTREAM_PORT}
TRUSTED_PROXY_CIDRS=${GATEWAY_TAILSCALE_IP}/32
