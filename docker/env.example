APP_ENV=production
APP_DEBUG=0
APP_DOMAIN=example.com
APP_SYS_ID=change-me-stable-8-chars
APP_SYS_MAIL=admin@example.com
APP_CFG_LINK=_cfg
APP_DEMO_MODE=0
APP_DATA_KEY=change-me-long-random-data-encryption-key
APP_DATA_KEY_FILE=
APP_BIND_IP=127.0.0.1
APP_PORT=8080
APP_IMAGE=h-script
APP_IMAGE_TAG=local
APP_PULL_POLICY=build
APP_EXTERNAL_NETWORK=external-proxy-network
APP_NETWORK_ALIAS=hscript-app
# Add only the exact reverse-proxy addresses/subnets. Private ranges are not trusted by default.
# With a remote Nginx/Authelia gateway, use its exact Tailscale IPv4 with /32.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Optional direct Configurator allowlist. Leave empty unless recovery access is ready.
CONFIGURATOR_ALLOWED_CIDRS=
CONFIGURATOR_PASSWORD=change-me-configurator-password
CONFIGURATOR_PASSWORD_FILE=
ALLOW_EMPTY_CONFIGURATOR_PASSWORD=0

# Installation registration is mandatory. Public aggregates are enabled by default.
TELEMETRY_ENDPOINT=https://h-script.com/api/v1/installations
INSTALL_TELEMETRY_STATS=1

# Enable these only on the central h-script.com collector.
TELEMETRY_COLLECTOR_ENABLED=0
TELEMETRY_COLLECTOR_DOMAIN=h-script.com
TELEMETRY_RATE_LIMIT=30

# Verified database backups. Keep the path empty to use the protected backup/ volume.
BACKUP_STORAGE_PATH=
BACKUP_MAX_BYTES=2147483648
BACKUP_MIN_FREE_BYTES=134217728
BACKUP_RETENTION_COUNT=10
BACKUP_RETENTION_DAYS=30
BACKUP_MYSQLDUMP_PATH=
BACKUP_MYSQL_PATH=

# Shared-hosting updater limits. Official archives and SHA256SUMS are read from
# https://github.com/0x241/h-script/releases; Docker updates use APP_IMAGE_TAG.
UPDATE_WORK_PATH=
UPDATE_MAX_PACKAGE_BYTES=268435456
UPDATE_MAX_UNPACKED_BYTES=536870912
UPDATE_MAX_FILES=10000
UPDATE_MIN_FREE_BYTES=134217728
UPDATE_RETENTION_COUNT=3

# Local file-integrity scan. Twig changes are reported as customization, not alerts.
INTEGRITY_SCAN_BATCH_FILES=1000
INTEGRITY_SCAN_MAX_SECONDS=10
INTEGRITY_SCAN_MAX_FILES=20000
INTEGRITY_SCAN_MAX_FINDINGS=500
INTEGRITY_NOTIFY=0

DB_NAME=hscript
DB_USER=hscript
DB_PASSWORD=change-me-db-password
DB_PASSWORD_FILE=
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_ROOT_PASSWORD_FILE=
DB_TYPE=1

REQUIRE_TURNSTILE=1
TURNSTILE_SITE_KEY=change-me-site-key
TURNSTILE_SITE_KEY_FILE=
TURNSTILE_SECRET_KEY=change-me-secret-key
TURNSTILE_SECRET_KEY_FILE=

APP_AUTO_INSTALL=0
INSTALL_ADMIN_NAME=Administrator
INSTALL_ADMIN_LOGIN=admin
INSTALL_ADMIN_PASSWORD=change-me-admin-password
INSTALL_ADMIN_PASSWORD_FILE=
INSTALL_ADMIN_MAIL=admin@example.com
INSTALL_ADMIN_SECRET_QUESTION=That is your name
INSTALL_ADMIN_SECRET_ANSWER=change-me-secret-answer
INSTALL_ADMIN_SECRET_ANSWER_FILE=
INSTALL_ADMIN_PIN=change-me-pin
INSTALL_ADMIN_PIN_FILE=

# Initial mail settings. Applied only while APP_AUTO_INSTALL=1.
INSTALL_MAIL_HOST=
INSTALL_MAIL_PORT=587
INSTALL_MAIL_SECURE=1
INSTALL_MAIL_USERNAME=
INSTALL_MAIL_PASSWORD=
INSTALL_MAIL_PASSWORD_FILE=
INSTALL_MAIL_PASSWORD_B64=
INSTALL_MAIL_FROM_ADDRESS=
INSTALL_MAIL_ADMIN_ADDRESS=
INSTALL_MAIL_ADMIN_LANG=en

INSTALL_DEMO_ADMIN_NAME=Demo Administrator
INSTALL_DEMO_ADMIN_LOGIN=demo-admin
INSTALL_DEMO_ADMIN_PASSWORD=change-me-demo-admin-password
INSTALL_DEMO_ADMIN_PASSWORD_FILE=
INSTALL_DEMO_ADMIN_MAIL=demo-admin@example.com
INSTALL_DEMO_ADMIN_SECRET_QUESTION=That is your demo name
INSTALL_DEMO_ADMIN_SECRET_ANSWER=change-me-demo-secret-answer
INSTALL_DEMO_ADMIN_SECRET_ANSWER_FILE=
INSTALL_DEMO_ADMIN_PIN=change-me-demo-pin
INSTALL_DEMO_ADMIN_PIN_FILE=
INSTALL_NO_LOGINS=0
INSTALL_INT_CURR=0
INSTALL_INT_CURR_ID=USD

CRON_ENABLED=1
CRON_URL=http://app/cron
CRON_HOST_HEADER=
CRON_INTERVAL_SECONDS=60
CRON_TIMEOUT_SECONDS=30
CRON_START_DELAY_SECONDS=10

SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_GC_MAXLIFETIME=2592000
