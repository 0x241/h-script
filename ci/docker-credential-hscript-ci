#!/usr/bin/env python3
"""Docker helper for one job's registry credentials; never persists credentials."""
import json
import os
from pathlib import Path
import re
import sys


def main():
    registry = os.environ.get("CI_REGISTRY", "")
    username = os.environ.get("CI_REGISTRY_USER", "")
    secret = os.environ.get("CI_REGISTRY_PASSWORD", "")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?", registry) or not username or not secret:
        raise ValueError("Job registry credentials are unavailable")
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "configure" and len(sys.argv) == 3:
        directory = Path(sys.argv[2])
        if directory.is_symlink() or not directory.is_dir():
            raise ValueError("Private Docker config directory required")
        metadata = directory.stat()
        if metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
            raise ValueError("Docker config directory must be owner-only")
        descriptor = os.open(directory / "config.json", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w") as output:
            json.dump({"credHelpers": {registry: "hscript-ci"}}, output)
            output.write("\n")
    elif action == "get" and len(sys.argv) == 2:
        requested = sys.stdin.readline(1025).strip()
        if requested not in (registry, "https://" + registry, "https://" + registry + "/"):
            raise ValueError("Registry is outside this job's credential scope")
        json.dump({"Username": username, "Secret": secret}, sys.stdout)
        sys.stdout.write("\n")
    elif action in ("erase", "list"):
        if action == "list":
            print(json.dumps({registry: username}))
    else:
        raise ValueError("Credential storage is disabled")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError):
        # No exception payload: it could contain caller-controlled input.
        print("CI registry credential helper rejected the request", file=sys.stderr)
        sys.exit(1)
